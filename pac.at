name: "notes"
version: "1.0.0"
scene: "ui"
render: "vue"
icon: "notebook"
title: "Notes"
title_zh: "备忘录"
# PLAN-637 T-06：经 635 通道消费 stylekit 共享配方（caption_text ×5）
# PLAN-056 T-02（auto-os/PLAN-056 主合同反链见 README）：theme 显式键移除
# ——跟随主题链（宿主策略完整快照 > 本 design 默认 > legacy 回退）。显式值
# 会以 pac 优先级压过宿主跟随，两族×明暗需求下不声明。原 dark 默认改由
# app.at design 腿 + store dark_mode 默认位承接（独立运行默认暗色不变）。
accent: "indigo"
api: "rust"
# NOTES-004 T-00：当前工具链（auto-ui-tools npm_deps_from_value）的数组形态
# 按 '@' 裸切分，scoped 名解析失败；改用受支持的对象形态 { file: path }。
npm_deps: { "@autodown/engine": { file: "../../../vendor/auto-down/autodown/packages/engine" } }

dep stylekit {
    path: "vendor/stylekit"
}

# PLAN-056 T-02：官方主题包正式接入——`vendor/themes` 为 UI 管理渠道发布的
# **固定版本快照**（themes 0.2.0，内容 digest
# 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
# 与源包逐文件 sha256 校验等价；不可二次编辑、非第二权威源）。theme 键保持
# 缺省 = follow 语义。品牌 accent（indigo）与外观面板四色板豁免不映射。
dep themes {
    path: "vendor/themes"
}

desktop: "true"
front_port: 17818
back_port: 17819
