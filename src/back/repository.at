// 测试钩子（v1_test_* 端点委托；SQLite 版本无内存态可复位——
// 幂等由 DB 保证，reset 仅确保 schema）
// ═══════════════════════════════════════════════════════════

pub fn test_reset() {
    var db SqliteDb = sqlite.open(db_path())
    ensure_schema(db)
}

pub fn test_load_manifest() bool {
    return true
}
