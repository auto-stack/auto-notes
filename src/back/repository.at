// repository.at — NOTES-001 Phase 2：SQLite 单写者可靠存储（r3/T-05 协议冻结实现）。
//
// 能力依据：tests/probe/PHASE2-CAPABILITY-REPORT.md（T-05 实测：事务 batch、
// 跨连接 BEGIN IMMEDIATE 排他、回滚、'' 转义 + Unicode 往返全部通过）。
// SQLite（a2r-std rusqlite 封装）提供：事务级串行化（BEGIN IMMEDIATE）、
// 跨连接/跨进程原子排他（SQLITE_BUSY）、崩溃安全（WAL+回滚）。
// Phase 1 的 JSON 文件布局与文件锁整体退役（SD 增量）。
// 本模块不导入 api 类型（避免 api→db→repository→api 循环导入，D-742-1）：
// 全部 I/O 为 JSON 字符串；db.at 解析并构造 legacy Note 视图。
//
// 模式（T-06 门禁覆盖所有变更与读取入口；迁移同门禁）：
//   每请求独立 sqlite.open → busy_timeout=3000 → BEGIN IMMEDIATE →
//   以 DB 当前状态做检查（幂等/revision/存在性）→ 写入 →
//   INSERT requests（request_id↔note_id 同事务绑定）→ COMMIT。
//   任一步失败 → ROLLBACK + 错误 JSON；绝无部分状态。
// 幂等：requests 表命中 → 返回原 note JSON（AC-02）。
// 迁移：meta.migrated=1 + legacy_id UNIQUE ⇒ 重试幂等（AC-03）。
// 双进程：BEGIN IMMEDIATE 由 SQLite 文件锁排他，后到 BUSY → second_writer。

use auto.env
use auto.sqlite
use auto.json

pub fn data_dir() str {
    var ov str = env.get("NOTES_DATA_DIR")
    var base str = ov
    if base == "" {
        base = env.get("APPDATA")
    }
    if base == "" {
        base = env.get("XDG_DATA_HOME")
    }
    if base == "" {
        base = env.get("HOME") + "/.local/share"
    }
    if base == "" {
        base = "."
    }
    var dir str = base + "/auto-notes/data"
    if ov != "" {
        dir = ov
    }
    // 目录必须真实存在：sqlite.open 对缺父目录的路径会静默回退
    // 内存库（哨兵约定），迁移/写入全部落空。每次解析即兜底建目录。
    fs_mkdir(dir)
    return dir
}

pub fn db_path() str {
    return data_dir() + "/inbox.db"
}

// ═══════════════════════════════════════════════════════════
// 基础助手（无 SqliteDb 参数——每助手自开连接，连接廉价 RAII 关闭）
// ═══════════════════════════════════════════════════════════

/// SQL 字符串字面量：单引号包裹 + 内部 ' 翻倍（bundled SQLite DQS=0，
/// 双引号是标识符不是字面量——json.encode 的双引号在 VALUES/WHERE 里必炸）。
fn sql_str(s str) str {
    return "'" + s.replace("'", "''") + "'"
}

fn parse_int(s str) int {
    var r int = 0
    var neg bool = false
    var i int = 0
    var n int = s.len()
    if n > 0 {
        var c0 int = s.char_at(0)
        if c0 == 45 {
            neg = true
            i = 1
        }
    }
    while i < n {
        var cp int = s.char_at(i)
        if cp != 0 {
            if cp >= 48 {
                if cp <= 57 {
                    r = r * 10 + cp - 48
                }
            }
        }
        i = i + 1
    }
    if neg {
        r = 0 - r
    }
    return r
}

fn note_cols() str {
    return "note_id, legacy_id, revision, title, body, tags_json, color, pinned, state, folder, seq, created_at, updated_at"
}

fn empty_result_json() str {
    return "{\"ok\":false,\"doc\":{\"legacy_id\":-1},\"receipt\":{\"status\":\"\"}}"
}

pub fn ui_request_id(prefix str) str {
    return prefix + "-" + json.encode(next_req_seq())
}

/// 自动 request_id 的专用单调序列。绝不可复用笔记 seq 计数器：update 不推进
/// 笔记计数器，两次连续 update 会拿到同一 rid，第二次命中 requests 表回放
/// 直接返回旧信封（ok=true 但不写入——已在冒烟中实证）。req_seq 每取一次自增。
fn next_req_seq() int {
    var db SqliteDb = sqlite.open(db_path())
    var up int = db.exec("UPDATE meta SET v = CAST(CAST(v AS INTEGER) + 1 AS TEXT) WHERE k='req_seq'")
    if up == 0 {
        db.exec("INSERT INTO meta(k, v) VALUES('req_seq', '1')")
    }
    var v str = meta_get_on(db, "req_seq")
    return parse_int(v)
}

pub fn nid_of(id int) str {
    return "n-" + json.encode(id)
}

/// request_id 校验（F-001-06/SD-06）：非空、≤100 字符、仅 [A-Za-z0-9._:-]。
/// SQLite 时代 request_id 是表键不是路径（穿越类已结构性消除），校验仍拒绝
/// 引号/斜杠/控制字符，保证键的语义与日志/导出安全。
fn valid_request_id(rid str) bool {
    if rid == "" {
        return false
    }
    if rid.len() > 100 {
        return false
    }
    var n int = rid.len()
    for i in 0..n {
        var c int = rid.char_at(i)
        var ok bool = false
        if c >= 48 {
            if c <= 57 {
                ok = true
            }
        }
        if c >= 65 {
            if c <= 90 {
                ok = true
            }
        }
        if c >= 97 {
            if c <= 122 {
                ok = true
            }
        }
        if c == 45 {
            ok = true
        }
        if c == 95 {
            ok = true
        }
        if c == 46 {
            ok = true
        }
        if c == 58 {
            ok = true
        }
        if ok == false {
            return false
        }
    }
    return true
}

fn ensure_schema(db SqliteDb) {
    db.exec("PRAGMA busy_timeout=3000")
    db.exec("PRAGMA journal_mode=WAL")
    db.exec("CREATE TABLE IF NOT EXISTS notes(note_id TEXT PRIMARY KEY, legacy_id INTEGER UNIQUE, revision INTEGER NOT NULL DEFAULT 1, title TEXT NOT NULL DEFAULT '', body TEXT NOT NULL DEFAULT '', tags_json TEXT NOT NULL DEFAULT '[]', color TEXT NOT NULL DEFAULT '', pinned INTEGER NOT NULL DEFAULT 0, state TEXT NOT NULL DEFAULT 'active', folder TEXT NOT NULL DEFAULT '', seq INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL DEFAULT '', updated_at TEXT NOT NULL DEFAULT '')")
    // schema v2（SD-09/T-14）：requests 增加持久意图与原收据列。
    // rev/doc_json = 提交时的收据修订与文档快照（重放不得被后续变更改写）；
    // intent = 规范化意图串（kind|目标|内容），同 rid 不同意图明确拒绝。
    db.exec("CREATE TABLE IF NOT EXISTS requests(request_id TEXT PRIMARY KEY, note_id TEXT NOT NULL, kind TEXT NOT NULL, rev INTEGER NOT NULL DEFAULT 0, doc_json TEXT NOT NULL DEFAULT '', intent TEXT NOT NULL DEFAULT '')")
    db.exec("CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT NOT NULL)")
    // 既有 v1 库的列升级：列已存在时 ALTER 失败（exec=-1），无害
    db.exec("ALTER TABLE requests ADD COLUMN rev INTEGER NOT NULL DEFAULT 0")
    db.exec("ALTER TABLE requests ADD COLUMN doc_json TEXT NOT NULL DEFAULT ''")
    db.exec("ALTER TABLE requests ADD COLUMN intent TEXT NOT NULL DEFAULT ''")
    db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('schema_v','2')")
    seed_if_requested(db)
}

// 显式 seed 模式（NOTES_SEED=1，T-03）：仅全新目录写入示例笔记（tag "seed"
// 标记，非用户数据）；默认绝不注入（AC-05）。meta.seeded 快速跳过；
// seed-N request_id 保证幂等。
fn seed_if_requested(db SqliteDb) {
    if env.get("NOTES_SEED") != "1" {
        return
    }
    if meta_get_on(db, "seeded") == "1" {
        return
    }
    // 先占位再播种：repo_create 内部会再走 ensure_schema→seed_if_requested，
    // 不先写标记就是无限递归（STATUS_STACK_OVERFLOW 已实证）。
    db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('seeded','1')")
    var t1 str = json.encode(seed_tags("intro"))
    var s1 = repo_create("Welcome", "This is your notes app. Click on any note to view it.", "", t1, "seed-1")
    var t2 str = json.encode(seed_tags("ideas"))
    var s2 = repo_create("Quick Ideas", "Build a markdown editor with live preview.", "", t2, "seed-2")
    var t3 str = json.encode(seed_tags("home"))
    var s3 = repo_create("Shopping List", "Milk, Eggs, Bread, Cheese", "personal", t3, "seed-3")
    var t4 str = json.encode(seed_tags("home"))
    var s4 = repo_create("Recipe: Pasta", "200g flour, 2 eggs, pinch of salt.", "personal", t4, "seed-4")
    var t5 str = json.encode(seed_tags("work"))
    var s5 = repo_create("Meeting Notes", "Q3 roadmap discussion.", "work", t5, "seed-5")
    var t6 str = json.encode(seed_tags("work"))
    var s6 = repo_create("Sprint Planning", "Sprint 12 planning notes.", "work", t6, "seed-6")
    var it1 = json.parse(s1)
    var note_v = json.get(it1, "note")
    var nid_v = json.get(note_v, "note_id")
    var p1 = repo_set_pinned(json.as_string(nid_v), true)
}

fn seed_tags(tag str) List<str> {
    var t List<str> = List<str>.new([])
    t.push(tag)
    t.push("seed")
    return t
}

fn meta_get_on(db SqliteDb, k str) str {
    var sql str = "SELECT v FROM meta WHERE k=" + sql_str(k)
    var rows List<List<str>> = db.query(sql)
    if rows.len() > 0 {
        var row0 = rows[0]
        return row0[0]
    }
    return ""
}

// ═══════════════════════════════════════════════════════════
// 行 → 文档 JSON（13 列固定序）
// ═══════════════════════════════════════════════════════════

fn row_to_doc_json(row List<str>) str {
    var s str = "{\"schema_version\":1,\"note_id\":" + json.encode(row[0])
    s = s + ",\"legacy_id\":" + row[1]
    s = s + ",\"revision\":" + row[2]
    s = s + ",\"title\":" + json.encode(row[3])
    s = s + ",\"body\":" + json.encode(row[4])
    s = s + ",\"tags\":" + row[5]
    s = s + ",\"color\":" + json.encode(row[6])
    // SQLite 存 0/1 整数——文档契约是 JSON boolean（as_bool 对数字恒 false）
    var pin_txt str = "false"
    if row[7] == "1" {
        pin_txt = "true"
    }
    s = s + ",\"pinned\":" + pin_txt
    s = s + ",\"state\":" + json.encode(row[8])
    s = s + ",\"folder\":" + json.encode(row[9])
    s = s + ",\"seq\":" + row[10]
    s = s + ",\"created_at\":" + json.encode(row[11])
    s = s + ",\"updated_at\":" + json.encode(row[12]) + "}"
    return s
}

// ═══════════════════════════════════════════════════════════
// 打开
// ═══════════════════════════════════════════════════════════

pub fn open_repository() str {
    var db SqliteDb = sqlite.open(db_path())
    ensure_schema(db)
    var uerr str = upgrade_if_legacy(db)
    if uerr != "" {
        return uerr
    }
    return ""
}

/// Phase 1 JSON 布局 → SQLite 安全升级（SD-07/T-12，F-R4-01）。
/// 仅当 notes 空且未升级过时探测 manifest.json；事务化导入 entries
/// （实体 blocks→body，多块以换行符连接），receipts/ 经 D9 fs.list_dir 枚举
/// 导入请求映射（旧行 intent/doc 通配）；旧树整体复制到 legacy-backup/
/// 原件不动；坏实体逐项记入 meta.corrupted_r1 并跳过不终止；
/// meta.upgraded 占位防重复；失败 ROLLBACK 返回结构化错误，
/// 绝不以空库冒充成功（AC-01）。
fn upgrade_if_legacy(db SqliteDb) str {
    if meta_get_on(db, "upgraded") == "1" {
        return ""
    }
    var cnt_rows List<List<str>> = db.query("SELECT COUNT(*) FROM notes")
    if cnt_rows.len() > 0 {
        if parse_int(cnt_rows[0][0]) > 0 {
            return ""
        }
    }
    var mpath str = data_dir() + "/manifest.json"
    if fs_exists(mpath) == false {
        db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('upgraded','1')")
        return ""
    }
    var bak str = data_dir() + "/legacy-backup"
    fs_mkdir(bak)
    fs_copy(mpath, bak + "/manifest.json")
    fs_copy(data_dir() + "/notes", bak + "/notes")
    fs_copy(data_dir() + "/receipts", bak + "/receipts")
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return "second_writer"
    }
    var raw str = fs_read(mpath)
    if json.is_valid(raw) == false {
        db.exec("ROLLBACK")
        db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('upgrade_error','manifest unreadable')")
        return "storage_unwritable"
    }
    var m = json.parse(raw)
    var entries = json.get(m, "entries")
    var en int = json.len(entries)
    var bad_n int = 0
    var bad_list str = ""
    for i in 0..en {
        var e = json.get_at(entries, i)
        var fid str = json.as_string(json.get(e, "file"))
        var eraw str = fs_read(data_dir() + "/notes/" + fid)
        if json.is_valid(eraw) == false {
            var sep0 str = ""
            if bad_n > 0 {
                sep0 = ","
            }
            bad_list = bad_list + sep0 + "{\"index\":" + json.encode(i) + ",\"reason\":\"entity unreadable\",\"file\":" + json.encode(fid) + "}"
            bad_n = bad_n + 1
        } else {
            var it = json.parse(eraw)
            var nid_v = json.get(it, "note_id")
            var nid str = json.as_string(nid_v)
            var rev_v = json.get(it, "revision")
            var rev int = json.as_int(rev_v)
            var title_v = json.get(it, "title")
            var title str = json.as_string(title_v)
            // blocks → body（多块以换行符连接；v1 只产生 text 块）
            var blocks = json.get(it, "blocks")
            var bn int = json.len(blocks)
            var body str = ""
            var bj int = 0
            for b in 0..bn {
                var blk = json.get_at(blocks, b)
                var tv = json.get(blk, "text")
                if bj > 0 {
                    body = body + "
"
                }
                body = body + json.as_string(tv)
                bj = bj + 1
            }
            var tags_v = json.get(it, "tags")
            var tags_json str = json.encode(tags_v)
            var color_v = json.get(it, "color")
            var color str = json.as_string(color_v)
            var pin_v = json.get(it, "pinned")
            var pinb str = json.encode(pin_v)
            var pin int = 0
            if pinb == "true" {
                pin = 1
            }
            var state_v = json.get(it, "state")
            var state str = json.as_string(state_v)
            var folder_v = json.get(it, "folder")
            var folder str = json.as_string(folder_v)
            var seq_v = json.get(it, "seq")
            var seq int = json.as_int(seq_v)
            var leg_v = json.get(it, "legacy_id")
            var leg int = json.as_int(leg_v)
            var cr_v = json.get(it, "created_at")
            var cr str = json.as_string(cr_v)
            var up_v = json.get(it, "updated_at")
            var up str = json.as_string(up_v)
            var ins int = db.exec("INSERT INTO notes(note_id, legacy_id, revision, title, body, tags_json, color, pinned, state, folder, seq, created_at, updated_at) VALUES(" + sql_str(nid) + ", " + json.encode(leg) + ", " + json.encode(rev) + ", " + sql_str(title) + ", " + sql_str(body) + ", " + sql_str(tags_json) + ", " + sql_str(color) + ", " + json.encode(pin) + ", " + sql_str(state) + ", " + sql_str(folder) + ", " + json.encode(seq) + ", " + sql_str(cr) + ", " + sql_str(up) + ")")
            if ins < 0 {
                db.exec("ROLLBACK")
                db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('upgrade_error','entity import failed: ' + fid)")
                return "storage_unwritable"
            }
        }
    }
    var c_v = json.get(m, "counter")
    var counter int = json.as_int(c_v)
    db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('counter'," + json.encode(counter) + ")")
    // receipts → requests 映射（旧行 intent/doc_json 空 = 通配重放）
    var rdir str = data_dir() + "/receipts"
    var names List<str> = fs.dir_names(rdir)
    var rn int = names.len()
    for k in 0..rn {
        var name str = names[k]
        var rraw str = fs_read(rdir + "/" + name)
        if json.is_valid(rraw) {
            var rit = json.parse(rraw)
            var rid_v = json.get(rit, "request_id")
            var rid str = json.as_string(rid_v)
            var rnid_v = json.get(rit, "note_id")
            var rnid str = json.as_string(rnid_v)
            var rrev_v = json.get(rit, "revision")
            var rrev int = json.as_int(rrev_v)
            var rst_v = json.get(rit, "status")
            var rst str = json.as_string(rst_v)
            if rid != "" {
                if rst == "committed" {
                    db.exec("INSERT OR IGNORE INTO requests(request_id, note_id, kind, rev, doc_json, intent) VALUES(" + sql_str(rid) + ", " + sql_str(rnid) + ", '', " + json.encode(rrev) + ", '', '')")
                }
            }
        }
    }
    if bad_n > 0 {
        db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('corrupted_r1'," + sql_str("[\"legacy upgrade\"," + bad_list + "]") + ")")
    }
    db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('upgraded','1')")
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return "storage_unwritable"
    }
    return ""
}

// ═══════════════════════════════════════════════════════════
// 幂等收据查询（requests 表）
// ═══════════════════════════════════════════════════════════

pub fn read_receipt(request_id str) str {
    var rc str = "{\"schema_version\":1,\"request_id\":" + json.encode(request_id)
    rc = rc + ",\"note_id\":\"\",\"revision\":0,\"status\":\"\"}"
    if request_id == "" {
        return rc
    }
    var db SqliteDb = sqlite.open(db_path())
    ensure_schema(db)
    var esc str = json.encode(request_id)
    var sql str = "SELECT note_id FROM requests WHERE request_id=" + sql_str(request_id)
    var rows List<List<str>> = db.query(sql)
    if rows.len() < 1 {
        return rc
    }
    var row = rows[0]
    var nid str = row[0]
    rc = "{\"schema_version\":1,\"request_id\":" + json.encode(request_id)
    rc = rc + ",\"note_id\":" + json.encode(nid) + ",\"status\":\"committed\"}"
    return rc
}

// ═══════════════════════════════════════════════════════════
// 变更入口（T-06/T-07）：BEGIN IMMEDIATE 门禁覆盖检查+写区间；
// requests 同事务绑定 request_id↔note_id（AC-02）。
// ═══════════════════════════════════════════════════════════

/// 幂等创建：命中 requests → 返回原 note（AC-02）。
pub fn repo_create(title str, body str, folder str, tags_json str, request_id str) str {
    var oerr str = open_repository()
    if oerr != "" {
        return "{\"ok\":false,\"err_code\":\"" + oerr + "\"}"
    }
    var rid str = request_id
    if rid == "" {
        rid = ui_request_id("auto")
    }
    if valid_request_id(rid) == false {
        return "{\"ok\":false,\"err_code\":\"invalid_request\"}"
    }
    // 规范化意图（SD-09）：同 rid 不同内容 = 不同意图，重放时明确拒绝
    var intent str = "create|" + title + "|" + body + "|" + folder + "|" + tags_json
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return "{\"ok\":false,\"err_code\":\"second_writer\"}"
    }
    // 幂等重放（事务内查询，杜绝 after_commit 重放重复）
    var dup = replay_in_txn(db, rid, "create", "", intent)
    if dup != "" {
        var fin int = db.exec("COMMIT")
        return dup
    }
    var handle int = next_counter_on(db)
    var note_id str = nid_of(handle)
    var seq int = handle
    var ins int = db.exec("INSERT INTO notes(note_id, legacy_id, revision, title, body, tags_json, color, pinned, state, folder, seq, created_at, updated_at) VALUES(" + sql_str(note_id) + ", " + json.encode(handle) + ", 1, " + sql_str(title) + ", " + sql_str(body) + ", " + sql_str(tags_json) + ", '', 0, 'active', " + sql_str(folder) + ", " + json.encode(seq) + ", '', '')")
    if ins < 0 {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    var cdoc str = load_doc_json_on(db, note_id)
    var ir int = db.exec("INSERT OR IGNORE INTO requests(request_id, note_id, kind, rev, doc_json, intent) VALUES(" + sql_str(rid) + ", " + sql_str(note_id) + ", 'create', 1, " + sql_str(cdoc) + ", " + sql_str(intent) + ")")
    if ir < 0 {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    var nv int = handle + 1
    var bump int = db.exec("INSERT INTO meta(k,v) VALUES('counter'," + json.encode(nv) + ") ON CONFLICT(k) DO UPDATE SET v=" + json.encode(nv))
    var fault str = env.get("NOTES_FAULT")
    if fault == "after_entity" {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"fault_injected\"}"
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    if fault == "after_manifest" {
        return "{\"ok\":false,\"err_code\":\"fault_injected\"}"
    }
    var doc = load_doc_json_on(db, note_id)
    var rc str = "{\"schema_version\":1,\"request_id\":" + json.encode(rid)
    rc = rc + ",\"note_id\":" + json.encode(note_id) + ",\"revision\":1,\"status\":\"committed\"}"
    return "{\"ok\":true,\"err_code\":\"\",\"note\":" + doc + ",\"receipt\":" + rc + "}"
}

/// 条件更新：expected_revision 不符 → revision_conflict（AC-04）。
/// 幂等重放先于 revision 检查（AC-02）。
pub fn repo_update(note_id str, expected_revision int, title str, body str, request_id str) str {
    var oerr str = open_repository()
    if oerr != "" {
        return "{\"ok\":false,\"err_code\":\"" + oerr + "\"}"
    }
    var rid str = request_id
    if rid == "" {
        rid = ui_request_id("auto-upd")
    }
    if valid_request_id(rid) == false {
        return "{\"ok\":false,\"err_code\":\"invalid_request\"}"
    }
    // 意图串含目标与期望修订：同 rid 换目标/内容/期望修订 = 不同意图
    var intent str = "update|" + note_id + "|" + json.encode(expected_revision) + "|" + title + "|" + body
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return "{\"ok\":false,\"err_code\":\"second_writer\"}"
    }
    var dup = replay_in_txn(db, rid, "update", note_id, intent)
    if dup != "" {
        var fin int = db.exec("COMMIT")
        return dup
    }
    if dup != "" {
        var fin int = db.exec("COMMIT")
        return dup
    }
    var rows List<List<str>> = db.query("SELECT revision FROM notes WHERE note_id=" + sql_str(note_id))
    if rows.len() < 1 {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"not_found\"}"
    }
    var row0 = rows[0]
    var cur_rev int = parse_int(row0[0])
    if cur_rev != expected_revision {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"revision_conflict\",\"current_revision\":" + json.encode(cur_rev) + "}"
    }
    var new_rev int = expected_revision + 1
    var upd int = db.exec("UPDATE notes SET revision=" + json.encode(new_rev) + ", title=" + sql_str(title) + ", body=" + sql_str(body) + " WHERE note_id=" + sql_str(note_id))
    if upd < 0 {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    var udoc str = load_doc_json_on(db, note_id)
    var urc int = db.exec("INSERT OR IGNORE INTO requests(request_id, note_id, kind, rev, doc_json, intent) VALUES(" + sql_str(rid) + ", " + sql_str(note_id) + ", 'update', " + json.encode(new_rev) + ", " + sql_str(udoc) + ", " + sql_str(intent) + ")")
    if urc < 0 {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    var fault str = env.get("NOTES_FAULT")
    if fault == "after_entity" {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"fault_injected\"}"
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    if fault == "after_manifest" {
        return "{\"ok\":false,\"err_code\":\"fault_injected\"}"
    }
    var doc = load_doc_json_on(db, note_id)
    var rc str = "{\"schema_version\":1,\"request_id\":" + json.encode(rid)
    rc = rc + ",\"note_id\":" + json.encode(note_id) + ",\"revision\":" + json.encode(new_rev) + ",\"status\":\"committed\"}"
    return "{\"ok\":true,\"err_code\":\"\",\"note\":" + doc + ",\"receipt\":" + rc + "}"
}

/// 元数据变更（state/pinned/tags/folder）
fn repo_set_meta(note_id str, new_state str, pin int, tags_json str, set_tags bool, folder str, set_folder bool) str {
    var oerr str = open_repository()
    if oerr != "" {
        return "{\"ok\":false,\"err_code\":\"" + oerr + "\"}"
    }
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return "{\"ok\":false,\"err_code\":\"second_writer\"}"
    }
    var cnt_rows List<List<str>> = db.query("SELECT note_id FROM notes WHERE note_id=" + sql_str(note_id))
    if cnt_rows.len() < 1 {
        db.exec("ROLLBACK")
        return "{\"ok\":false,\"err_code\":\"not_found\"}"
    }
    if new_state != "" {
        db.exec("UPDATE notes SET state=" + sql_str(new_state) + " WHERE note_id=" + sql_str(note_id))
    }
    if pin >= 0 {
        db.exec("UPDATE notes SET pinned=" + json.encode(pin) + " WHERE note_id=" + sql_str(note_id))
    }
    if set_tags {
        db.exec("UPDATE notes SET tags_json=" + sql_str(tags_json) + " WHERE note_id=" + sql_str(note_id))
    }
    if set_folder {
        db.exec("UPDATE notes SET folder=" + sql_str(folder) + " WHERE note_id=" + sql_str(note_id))
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return "{\"ok\":false,\"err_code\":\"storage_unwritable\"}"
    }
    var doc = load_doc_json_on(db, note_id)
    return "{\"ok\":true,\"note\":" + doc + "}"
}

pub fn repo_trash(note_id str) str {
    return repo_set_meta(note_id, "trashed", -1, "[]", false, "", false)
}

pub fn repo_archive(note_id str) str {
    return repo_set_meta(note_id, "archived", -1, "[]", false, "", false)
}

pub fn repo_restore(note_id str) str {
    return repo_set_meta(note_id, "active", -1, "[]", false, "", false)
}

pub fn repo_set_pinned(note_id str, pinned bool) str {
    var v int = 0
    if pinned {
        v = 1
    }
    return repo_set_meta(note_id, "", v, "[]", false, "", false)
}

pub fn repo_set_tags(note_id str, tags_json str) str {
    return repo_set_meta(note_id, "", -1, tags_json, true, "", false)
}

pub fn repo_move(note_id str, folder str) str {
    return repo_set_meta(note_id, "", -1, "[]", false, folder, true)
}

/// 读取单个文档 JSON（含 trashed）；无 → ""
pub fn repo_get(note_id str) str {
    var oerr str = open_repository()
    if oerr != "" {
        return ""
    }
    var db SqliteDb = sqlite.open(db_path())
    return load_doc_json_on(db, note_id)
}

/// active 列表 JSON 数组，seq 降序（新在前）
pub fn repo_list_active() str {
    var oerr str = open_repository()
    if oerr != "" {
        return "[]"
    }
    var db SqliteDb = sqlite.open(db_path())
    var sql str = "SELECT " + note_select_cols() + " FROM notes WHERE state='active' ORDER BY seq DESC"
    var rows List<List<str>> = db.query(sql)
    var out str = "["
    var n int = rows.len()
    for k in 0..n {
        var row = rows[k]
        if k > 0 {
            out = out + ","
        }
        out = out + row_to_doc_json(row)
    }
    out = out + "]"
    return out
}

/// 搜索：title/body 子串，大小写不敏感（SQL lower + LIKE）
pub fn repo_search(query str) str {
    var oerr str = open_repository()
    if oerr != "" {
        return "[]"
    }
    var like str = sql_str("%" + query.lower() + "%")
    var db SqliteDb = sqlite.open(db_path())
    var sql str = "SELECT " + note_select_cols() + " FROM notes WHERE state='active' AND (lower(title) LIKE " + like + " OR lower(body) LIKE " + like + ") ORDER BY seq DESC"
    var rows List<List<str>> = db.query(sql)
    var out str = "["
    var n int = rows.len()
    for k in 0..n {
        var row = rows[k]
        if k > 0 {
            out = out + ","
        }
        out = out + row_to_doc_json(row)
    }
    out = out + "]"
    return out
}

/// 诊断状态
pub fn repo_status() str {
    var db SqliteDb = sqlite.open(db_path())
    ensure_schema(db)
    var rows List<List<str>> = db.query("SELECT COUNT(*), COALESCE(MAX(CAST(legacy_id AS INTEGER)),0) FROM notes")
    var cnt int = 0
    var maxleg int = 0
    if rows.len() > 0 {
        var row0 = rows[0]
        cnt = parse_int(row0[0])
        maxleg = parse_int(row0[1])
    }
    var migrated str = meta_get_on(db, "migrated")
    var s str = "{\"loaded\":true,\"err\":\"\","
    s = s + "\"counter\":" + json.encode(next_counter_on(db))
    s = s + ",\"entries\":" + json.encode(cnt)
    s = s + ",\"max_legacy_id\":" + json.encode(maxleg)
    s = s + ",\"migrated\":" + json.encode(migrated)
    s = s + ",\"data_dir\":" + json.encode(data_dir())
    s = s + "}"
    return s
}

// ═══════════════════════════════════════════════════════════
// 迁移（T-08）：BEGIN IMMEDIATE 门禁内逐项校验；null/错类型/重复 id
// 进报告不终止；任一 DB 步失败 ROLLBACK（无损）；meta.migrated +
// legacy_id UNIQUE 重试幂等。旧 JSON 文件先备份后导入。
// ═══════════════════════════════════════════════════════════

pub fn migrate_legacy_at(legacy_path str) str {
    var db SqliteDb = sqlite.open(db_path())
    ensure_schema(db)
    var migrated_flag str = meta_get_on(db, "migrated")
    var cnt_rows List<List<str>> = db.query("SELECT COUNT(*) FROM notes")
    var have int = 0
    if cnt_rows.len() > 0 {
        have = parse_int(cnt_rows[0][0])
    }
    if have > 0 || migrated_flag == "1" {
        return "{\"attempted\":true,\"migrated\":0,\"skipped_existing\":true,\"saved\":false,\"err\":\"\",\"backup_file\":\"\",\"corrupted\":[]}"
    }
    var ex bool = fs_exists(legacy_path)
    if ex == false {
        return "{\"attempted\":false,\"migrated\":0,\"skipped_existing\":false,\"saved\":false,\"err\":\"\",\"backup_file\":\"\",\"corrupted\":[]}"
    }
    var raw str = fs_read(legacy_path)
    if raw == "" {
        return "{\"attempted\":true,\"migrated\":0,\"skipped_existing\":false,\"saved\":false,\"err\":\"storage_unwritable\",\"backup_file\":\"\",\"corrupted\":[]}"
    }
    fs_mkdir(data_dir() + "/backup")
    var bdst str = data_dir() + "/backup/notes.json.bak"
    var cpok bool = fs_copy(legacy_path, bdst)
    if cpok == false {
        return "{\"attempted\":true,\"migrated\":0,\"skipped_existing\":false,\"saved\":false,\"err\":\"storage_unwritable\",\"backup_file\":\"\",\"corrupted\":[]}"
    }
    var valid bool = json.is_valid(raw)
    var rows_json str = "[]"
    var pre_corrupted str = ""
    var top_bad str = ""
    if valid {
        // 顶层严格校验（SD-08）：合法 JSON 但非数组 → 整体计坏项
        var head str = raw.trim().sub(0, 1)
        if head == "[" {
            rows_json = raw
        } else {
            top_bad = "top level not an array"
        }
    } else {
        var senv = json.parse(salvage_objects(raw))
        var items_v = json.get(senv, "items")
        rows_json = json.encode(items_v)
        var cor_v = json.get(senv, "corrupted")
        pre_corrupted = json.encode(cor_v)
    }
    var arr = json.parse(rows_json)
    var n int = json.len(arr)
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return "{\"attempted\":true,\"migrated\":0,\"skipped_existing\":false,\"saved\":false,\"err\":\"storage_unwritable\",\"backup_file\":" + json.encode(bdst) + ",\"corrupted\":[]}"
    }
    var corrupted str = ""
    if pre_corrupted.len() > 1 {
        corrupted = pre_corrupted.sub(1, pre_corrupted.len() - 1)
    }
    if top_bad != "" {
        if corrupted.len() > 0 {
            corrupted = corrupted + ","
        }
        corrupted = corrupted + "{\"index\":0,\"reason\":\"" + top_bad + "\",\"snippet\":\"\"}"
    }
    var migrated_n int = 0
    var ok_ids str = ","
    for i in 0..n {
        var it = json.get_at(arr, i)
        var it_t str = json.encode(it)
        var reason str = ""
        var idtxt str = ""
        if it_t == "null" {
            reason = "null entry"
        } else {
            var idv = json.get(it, "id")
            idtxt = json.encode(idv)
            if idtxt == "null" {
                reason = "missing id"
            }
            if reason == "" {
                var q1 str = idtxt.sub(0, 1)
                if q1 == "\"" {
                    reason = "id not an integer"
                }
            }
            if reason == "" {
                var hasdot bool = idtxt.contains(".")
                if hasdot {
                    reason = "id not an integer"
                }
            }
            if reason == "" {
                var dupmark str = "," + idtxt + ","
                if ok_ids.contains(dupmark) {
                    reason = "duplicate id in source"
                }
            }
            if reason == "" {
                // 严格类型（SD-08）：title 必须字符串（json.encode 输出 ASCII，
                // sub(0,1) 字节安全）
                var ttxt str = json.encode(json.get(it, "title"))
                if ttxt.sub(0, 1) != "\"" {
                    reason = "title not a string"
                }
            }
            if reason == "" {
                // tags 缺省容忍为 []；存在但非数组 → 坏项
                var ttj str = json.encode(json.get(it, "tags"))
                if ttj != "null" {
                    if ttj.sub(0, 1) != "[" {
                        reason = "tags not an array"
                    }
                }
            }
        }
        // 报告与插入平级（F-R4-02）：null/类型错也进报告，绝不静默跳过。
        // snippet = 整项 json.encode（纯 ASCII，任意字节截断安全）；超长省略
        // 内容而非非边界 sub（长中文/emoji 坏项不再 panic）。
        if reason != "" {
            var sep str = ""
            if corrupted.len() > 0 {
                sep = ","
            }
            var snip str = json.encode(it)
            if snip.len() > 400 {
                snip = "\"\""
            }
            corrupted = corrupted + sep + "{\"index\":" + json.encode(i) + ",\"reason\":" + json.encode(reason) + ",\"snippet\":" + snip + "}"
        } else {
            var seq int = next_counter_on(db)
            var title str = json.as_string(json.get(it, "title"))
            var bodyv str = json.as_string(json.get(it, "body"))
            var folder str = json.as_string(json.get(it, "folder"))
            var pin_v = json.get(it, "pinned")
            var pin int = 0
            var pin_s str = json.encode(pin_v)
            if pin_s == "true" {
                pin = 1
            }
            var ins int = db.exec("INSERT INTO notes(note_id, legacy_id, revision, title, body, tags_json, pinned, state, folder, seq) VALUES(" + sql_str("n-" + idtxt) + ", " + idtxt + ", 1, " + sql_str(title) + ", " + sql_str(bodyv) + ", " + sql_str(tags_json_of(it_t)) + ", " + json.encode(pin) + ", 'active', " + sql_str(folder) + ", " + json.encode(seq) + ")")
            if ins < 0 {
                db.exec("ROLLBACK")
                return "{\"attempted\":true,\"migrated\":0,\"skipped_existing\":false,\"saved\":false,\"err\":\"storage_unwritable\",\"backup_file\":" + json.encode(bdst) + ",\"corrupted\":[]}"
            }
            ok_ids = ok_ids + idtxt + ","
            migrated_n = migrated_n + 1
        }
    }
    // 报告与 corrupted 记录先于提交确认（SD-08）：报告写失败 → ROLLBACK，
    // 迁移整体可重试（migrated 标记未落），绝不 saved=true 丢报告。
    // 坏项同时持久化到 meta.corrupted_r1（事务内可靠数据）。
    var corrupted_json str = "[" + corrupted + "]"
    if corrupted != "" {
        fs_mkdir(data_dir() + "/corrupted")
        var report str = "{\"schema_version\":1,\"source\":" + json.encode(legacy_path) + ",\"corrupted\":[" + corrupted + "]}"
        var wok bool = fs_write(data_dir() + "/corrupted/report-r1.json", report)
        if wok == false {
            db.exec("ROLLBACK")
            return "{\"attempted\":true,\"migrated\":0,\"skipped_existing\":false,\"saved\":false,\"err\":\"storage_unwritable\",\"backup_file\":" + json.encode(bdst) + ",\"corrupted\":[" + corrupted + "]}"
        }
    }
    db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('corrupted_r1'," + sql_str(corrupted_json) + ")")
    db.exec("INSERT OR REPLACE INTO meta(k,v) VALUES('migrated','1')")
    var commit int = db.exec("COMMIT")
    var saved_str str = "true"
    if commit < 0 {
        saved_str = "false"
    }
    return "{\"attempted\":true,\"migrated\":" + json.encode(migrated_n) + ",\"skipped_existing\":false,\"saved\":" + saved_str + ",\"err\":\"\",\"backup_file\":" + json.encode(bdst) + ",\"corrupted\":[" + corrupted + "]}"
}

fn next_counter_on(db SqliteDb) int {
    var sql1 str = "SELECT COALESCE(MAX(CAST(legacy_id AS INTEGER)),0)+1 FROM notes"
    var rows List<List<str>> = db.query(sql1)
    var v int = 1
    if rows.len() > 0 {
        var row0 = rows[0]
        v = parse_int(row0[0])
    }
    var mrows List<List<str>> = db.query("SELECT v FROM meta WHERE k='counter'")
    if mrows.len() > 0 {
        var mrow = mrows[0]
        var c int = parse_int(mrow[0])
        if c > v {
            v = c
        }
    }
    return v
}

/// 事务内幂等重放（SD-09/T-14）：
/// - rid 未命中 → ""
/// - 命中且 kind/目标/意图 全匹配（或旧行通配）→ 原样返回存储的原收据与文档
///   快照——后续文档变更不得改写历史 receipt（update-1 rev2 → update-2 rev3 →
///   重放 update-1 仍 rev2）
/// - 命中但 kind/目标/意图 不一致 → request_conflict 信封（ok=false），
///   绝不能以 ok=true 确认一个未执行的新操作
/// 旧版行（升级导入/前 schema）intent/rev/doc_json 为空 → 通配：同目标同 kind
/// 即重放，rev 回退存储值/1，doc 现读。
fn replay_in_txn(db SqliteDb, rid str, kind str, note_id str, intent str) str {
    if rid == "" {
        return ""
    }
    var sql str = "SELECT note_id, kind, rev, doc_json, intent FROM requests WHERE request_id=" + sql_str(rid)
    var rows List<List<str>> = db.query(sql)
    if rows.len() < 1 {
        return ""
    }
    var row = rows[0]
    var s_note str = row[0]
    var s_kind str = row[1]
    var s_rev str = row[2]
    var s_doc str = row[3]
    var s_intent str = row[4]
    var kind_ok bool = s_kind == kind || s_kind == ""
    var target_ok bool = note_id == "" || s_note == note_id
    var intent_ok bool = s_intent == "" || s_intent == intent
    if kind_ok == false || target_ok == false || intent_ok == false {
        return "{\"ok\":false,\"err_code\":\"request_conflict\",\"err_detail\":\"same request_id used for a different operation/target/content\",\"doc\":{\"schema_version\":1,\"note_id\":\"\",\"revision\":0,\"title\":\"\",\"body\":\"\",\"tags\":[],\"color\":\"\",\"pinned\":false,\"state\":\"\",\"folder\":\"\",\"created_at\":\"\",\"updated_at\":\"\",\"legacy_id\":0,\"seq\":0},\"receipt\":{\"schema_version\":1,\"request_id\":\"\",\"note_id\":\"\",\"revision\":0,\"status\":\"\"}}"
    }
    var doc str = s_doc
    if doc == "" {
        doc = load_doc_json_on(db, s_note)
    }
    var rev_txt str = s_rev
    if rev_txt == "" || rev_txt == "0" {
        rev_txt = "1"
    }
    var rc str = "{\"schema_version\":1,\"request_id\":" + json.encode(rid)
    rc = rc + ",\"note_id\":" + json.encode(s_note) + ",\"revision\":" + rev_txt + ",\"status\":\"committed\"}"
    return "{\"ok\":true,\"err_code\":\"\",\"note\":" + doc + ",\"receipt\":" + rc + ",\"replayed\":true}"
}

fn load_doc_json_on(db SqliteDb, note_id str) str {
    var esc str = json.encode(note_id)
    var sql str = "SELECT " + note_select_cols() + " FROM notes WHERE note_id=" + sql_str(note_id)
    var rows List<List<str>> = db.query(sql)
    if rows.len() < 1 {
        return ""
    }
    var row = rows[0]
    return row_to_doc_json(row)
}

fn load_doc_json(note_id str) str {
    var db SqliteDb = sqlite.open(db_path())
    return load_doc_json_on(db, note_id)
}

/// 测试钩子（v1_test_listloop）
pub fn test_list_once() int {
    var js str = repo_list_active()
    var arr = json.parse(js)
    return json.len(arr)
}

fn fs_exists(p str) bool {
    return fs.exists(p)
}

fn fs_read(p str) str {
    return fs.read_text(p)
}

fn fs_mkdir(p str) bool {
    return fs.mkdir_all(p)
}

fn fs_write(p str, c str) bool {
    return fs.write_text(p, c)
}

fn fs_copy(a str, b str) bool {
    var ac str = a
    var bc str = b
    return fs.copy_recursive(ac, bc)
}

fn tags_json_of(item_json str) str {
    var it = json.parse(item_json)
    var tags_v = json.get(it, "tags")
    var tj str = json.encode(tags_v)
    var t1 str = tj.sub(0, 1)
    if t1 == "[" {
        return tj
    }
    return "[]"
}

fn note_select_cols() str {
    return "note_id, legacy_id, revision, title, body, tags_json, color, pinned, state, folder, seq, created_at, updated_at"
}

fn next_counter() int {
    var db SqliteDb = sqlite.open(db_path())
    return next_counter_on(db)
}

/// UTF-8 码点 → 字节宽（char_at 是字符索引、sub 是字节切片——
/// 二者各归其位：扫描用字符索引，切片用累计出的字节偏移）。
fn char_w(c int) int {
    var w int = 1
    if c >= 128 {
        w = 2
    }
    if c >= 2048 {
        w = 3
    }
    if c >= 65536 {
        w = 4
    }
    return w
}

/// 括号配平打捞（SD-04/T-13）：截断 JSON 中提取可解析对象；坏对象进报告并
/// 从下一字符续扫（[valid,截断,valid] → 捞回 2 + 坏项 1）。
/// 最短有效跨度：对每个 `{` 依次尝试其后每个 `}`（解析验证，首个有效即闭合）。
/// 字符索引与字节偏移经 char_w 严格同步（长中文/emoji 安全）。
/// 返回 {"items":[...],"corrupted":[...]} 信封。
fn salvage_objects(raw str) str {
    var out str = "["
    var cor str = ""
    var valid_n int = 0
    var bad_n int = 0
    var nb int = raw.len()
    var ci int = 0
    var cb int = 0
    for pass in 0..100000 {
        if ci < nb {
            var open_c int = -1
            var open_b int = -1
            var j int = ci
            var jb int = cb
            var stop1 bool = false
            for g1 in 0..1000000 {
                if stop1 == false {
                    var c int = raw.char_at(j)
                    if c == 0 {
                        stop1 = true
                    } else {
                        if c == 123 {
                            open_c = j
                            open_b = jb
                            stop1 = true
                        } else {
                            j = j + 1
                            jb = jb + char_w(c)
                        }
                    }
                }
            }
            if open_c >= 0 {
                var close_c int = -1
                var close_b int = -1
                var k int = open_c
                var kb int = open_b
                var stop2 bool = false
                for g2 in 0..1000000 {
                    if stop2 == false {
                        if k >= nb {
                            stop2 = true
                        } else {
                            var c2 int = raw.char_at(k)
                            if c2 == 0 {
                                stop2 = true
                            } else {
                                if c2 == 125 {
                                    var piece str = raw.sub(open_b, kb + 1)
                                    if json.is_valid(piece) {
                                        close_c = k
                                        close_b = kb
                                        stop2 = true
                                    }
                                }
                                k = k + 1
                                kb = kb + char_w(c2)
                            }
                        }
                    }
                }
                if close_c >= 0 {
                    var good str = raw.sub(open_b, close_b + 1)
                    if out != "[" {
                        out = out + ","
                    }
                    out = out + good
                    valid_n = valid_n + 1
                    ci = close_c + 1
                    cb = close_b + 1
                } else {
                    var rest str = raw.sub(open_b, nb)
                    var snip str = rest
                    if snip.len() > 400 {
                        snip = ""
                    }
                    var bad_index int = valid_n + bad_n
                    if bad_n > 0 {
                        cor = cor + ","
                    }
                    cor = cor + "{\"index\":" + json.encode(bad_index) + ",\"reason\":\"unparseable object\",\"snippet\":" + json.encode(snip) + "}"
                    bad_n = bad_n + 1
                    ci = open_c + 1
                    cb = open_b + 1
                }
            } else {
                ci = nb
            }
        }
    }
    out = out + "]"
    return "{\"items\":" + out + ",\"corrupted\":[" + cor + "]}"
}

