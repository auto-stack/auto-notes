#[api(method = "POST", path = "/api/v1/test/fault")]
pub fn v1_test_fault(stage str) str {
    return db.v1_test_fault(stage)
}

/// List all notes (most recently created first)
/// GET /api/notes
#[api(method = "GET", path = "/api/notes")]
pub fn list_notes() []Note {
    return db.all_notes()
}

/// Get a single note by ID
/// GET /api/notes/:id
#[api(method = "GET", path = "/api/notes/:id")]
pub fn get_note(id int) ?Note {
    return db.find_note(id)
}

/// Create a new note（request_id 幂等：双击/重试只建一条）
/// POST /api/notes
#[api(method = "POST", path = "/api/notes")]
pub fn create_note(title str, body str, folder str, request_id str) Note {
    return db.create_note(title, body, folder, request_id)
}

/// Update an existing note（条件更新：expected_revision 不符 → false，
/// 服务端版本保全；request_id 由 UI 每个草稿会话稳定持有，重试幂等）
/// PUT /api/notes/:id
#[api(method = "PUT", path = "/api/notes/:id")]
pub fn update_note(id int, expected_revision int, title str, body str, request_id str) bool {
    return db.update_note(id, expected_revision, title, body, request_id)
}

/// 条件更新（结构化结果版，SD-14/T-19）：err_code 区分明确拒绝与传输层
/// 未知结果（UI 未确认提交裁决的依据）
/// PUT /api/notes/:id/result
#[api(method = "PUT", path = "/api/notes/:id/result")]
pub fn update_note_r(id int, expected_revision int, title str, body str, request_id str) RepoResult {
    return db.update_note_r(id, expected_revision, title, body, request_id)
}

/// 读取单个文档（结构化结果版，SD-14/T-19：未确认提交裁决取服务器版本）
/// GET /api/notes/:id/result
#[api(method = "GET", path = "/api/notes/:id/result")]
pub fn get_note_r(id int) RepoResult {
    return db.get_note_r(id)
}

/// UI 每个草稿会话取一次稳定 request_id（重试同意图复用同一 id）
/// GET /api/request-id
#[api(method = "GET", path = "/api/request-id")]
pub fn next_request_id(prefix str) str {
    return db.next_request_id(prefix)
}

/// Delete a note by ID
/// DELETE /api/notes/:id
#[api(method = "DELETE", path = "/api/notes/:id")]
pub fn delete_note(id int) bool {
    return db.delete_note(id)
}

/// Toggle pin status
/// PATCH /api/notes/:id/pin
#[api(method = "PATCH", path = "/api/notes/:id/pin")]
pub fn toggle_pin(id int) ?Note {
    return db.toggle_pin(id)
}

/// Update tags for a note
/// PUT /api/notes/:id/tags
#[api(method = "PUT", path = "/api/notes/:id/tags")]
pub fn update_tags(id int, tags []str) ?Note {
    return db.update_tags(id, tags)
}

/// 置顶切换（结构化结果版，F-R9-01）：`?Note` None 被框架映射为 HTTP 404，
/// 生成客户端在非 2xx 抛异常，调用点永远收不到 null——存储拒绝必须走
/// RepoResult 信封（同 update_note_r 先例），UI 才能接收失败。
/// PATCH /api/notes/:id/pin/result
#[api(method = "PATCH", path = "/api/notes/:id/pin/result")]
pub fn toggle_pin_result(id int) RepoResult {
    return db.toggle_pin_result(id)
}

/// 标签更新（结构化结果版，F-R9-01）：同 pin/result 的理由。
/// POST /api/notes/:id/tags/result
#[api(method = "POST", path = "/api/notes/:id/tags/result")]
pub fn update_tags_result(id int, tags []str) RepoResult {
    return db.update_tags_result(id, tags)
}

/// Search notes by title + body
/// GET /api/notes/search?q=...
#[api(method = "GET", path = "/api/notes/search")]
pub fn search_notes(query str) []Note {
    return db.search_notes(query)
}

