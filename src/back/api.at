// ═══════════════════════════════════════════════════════════
// FeaturePack v0 端点（NOTES-006 T-02，notes.fpack/1；契约见 auto-os
// docs/specs/communication/featurepack-v0.md）。返回仓储信封 JSON 串
// （与 v1_status 同风格）；wire 门（版本/尝试 ID）在 db.fp_*。
// ═══════════════════════════════════════════════════════════

/// 就绪探针（桌面 daemon ensure 链固定契约 GET /api/health，AGENTS §3；
/// body interface 字段供版本就绪核验，featurepack-v0 §2.2）
#[api(method = "GET", path = "/api/health")]
pub fn fp_health() str {
    return db.fp_health()
}

/// 捕获：来源快照 + 可编辑正文 → note_id/revision/收据（幂等按 operation_id）
