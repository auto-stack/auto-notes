/// List all notes (most recently created first)
/// GET /api/notes
#[api(method = "GET", path = "/api/notes")]
pub fn list_notes() []Note {
    var docs []NoteDocument = repository.repo_list_active()
    var out List<Note> = List<Note>.new([])
    for d in docs {
        var body str = ""
        if d.blocks.len() > 0 {
            body = d.blocks[0].text
        }
        var t str = d.updated_at
        if t == "" {
            t = "Just now"
        }
        out.push(Note {
            id: d.legacy_id,
            title: d.title,
            body: body,
            time: t,
            pinned: d.pinned,
            tags: d.tags,
            folder: d.folder,
        })
    }
    return out
}

/// Get a single note by ID
/// GET /api/notes/:id
#[api(method = "GET", path = "/api/notes/:id")]
pub fn get_note(id int) ?Note {
    var r = repository.repo_get(repository.nid_of(id))
    if r.ok {
        var body str = ""
        if r.doc.blocks.len() > 0 {
            body = r.doc.blocks[0].text
        }
        var t str = r.doc.updated_at
        if t == "" {
            t = "Just now"
        }
        var n Note = Note {
            id: r.doc.legacy_id,
            title: r.doc.title,
            body: body,
            time: t,
            pinned: r.doc.pinned,
            tags: r.doc.tags,
            folder: r.doc.folder,
        }
        return Some(n)
    }
    return None
}

/// Create a new note
/// POST /api/notes
#[api(method = "POST", path = "/api/notes")]
pub fn create_note(title str, body str, folder str) Note {
    var tags List<str> = List<str>.new([])
    var r = repository.repo_create(title, body, folder, tags, "")
    var body str = ""
    if r.doc.blocks.len() > 0 {
        body = r.doc.blocks[0].text
    }
    var t str = r.doc.updated_at
    if t == "" {
        t = "Just now"
    }
    var note Note = Note {
        id: r.doc.legacy_id,
        title: r.doc.title,
        body: body,
        time: t,
        pinned: r.doc.pinned,
        tags: r.doc.tags,
        folder: r.doc.folder,
    }
    return note
}

/// Update an existing note
/// PUT /api/notes/:id
#[api(method = "PUT", path = "/api/notes/:id")]
pub fn update_note(id int, title str, body str) ?Note {
    var nid str = repository.nid_of(id)
    var cur = repository.repo_get(nid.as_str())
    if cur.ok == false {
        return None
    }
    var r = repository.repo_update(nid.as_str(), cur.doc.revision, title, body, "")
    if r.ok {
    var body str = ""
    if r.doc.blocks.len() > 0 {
        body = r.doc.blocks[0].text
    }
    var t str = r.doc.updated_at
    if t == "" {
        t = "Just now"
    }
    return Note {
        id: r.doc.legacy_id,
        title: r.doc.title,
        body: body,
        time: t,
        pinned: r.doc.pinned,
        tags: r.doc.tags,
        folder: r.doc.folder,
    }
    }
    return None
}

/// Delete a note by ID
/// DELETE /api/notes/:id
#[api(method = "DELETE", path = "/api/notes/:id")]
pub fn delete_note(id int) bool {
    var r = repository.repo_trash(repository.nid_of(id))
    return r.ok
}

/// Toggle pin status
/// PATCH /api/notes/:id/pin
#[api(method = "PATCH", path = "/api/notes/:id/pin")]
pub fn toggle_pin(id int) ?Note {
    var nid str = repository.nid_of(id)
    var cur = repository.repo_get(nid.as_str())
    if cur.ok == false {
        return None
    }
    var want bool = cur.doc.pinned == false
    var r = repository.repo_set_pinned(nid.as_str(), want)
    if r.ok {
    var body str = ""
    if r.doc.blocks.len() > 0 {
        body = r.doc.blocks[0].text
    }
    var t str = r.doc.updated_at
    if t == "" {
        t = "Just now"
    }
    return Note {
        id: r.doc.legacy_id,
        title: r.doc.title,
        body: body,
        time: t,
        pinned: r.doc.pinned,
        tags: r.doc.tags,
        folder: r.doc.folder,
    }
    }
    return None
}

/// Update tags for a note
/// PUT /api/notes/:id/tags
#[api(method = "PUT", path = "/api/notes/:id/tags")]
pub fn update_tags(id int, tags []str) ?Note {
    var r = repository.repo_set_tags(repository.nid_of(id), tags)
    if r.ok {
    var body str = ""
    if r.doc.blocks.len() > 0 {
        body = r.doc.blocks[0].text
    }
    var t str = r.doc.updated_at
    if t == "" {
        t = "Just now"
    }
    return Note {
        id: r.doc.legacy_id,
        title: r.doc.title,
        body: body,
        time: t,
        pinned: r.doc.pinned,
        tags: r.doc.tags,
        folder: r.doc.folder,
    }
    }
    return None
}

/// Search notes by title + body
/// GET /api/notes/search?q=...
#[api(method = "GET", path = "/api/notes/search")]
pub fn search_notes(query str) []Note {
    var docs []NoteDocument = repository.repo_search(query)
    var out List<Note> = List<Note>.new([])
    for d in docs {
        var body str = ""
        if d.blocks.len() > 0 {
            body = d.blocks[0].text
        }
        var t str = d.updated_at
        if t == "" {
            t = "Just now"
        }
        out.push(Note {
            id: d.legacy_id,
            title: d.title,
            body: body,
            time: t,
            pinned: d.pinned,
            tags: d.tags,
            folder: d.folder,
        })
    }
    return out
}
