// source/back/api.at - Notes API Interface
// CRUD + sort + pin + tags + search endpoints

// ═══════════════════════════════════════════════════════════
// Types (shared between frontend and backend)
// ═══════════════════════════════════════════════════════════

/// Note data model（r3：revision 随读保存、随写提交——SD-05 结果契约）
pub type Note = {
    id: int
    revision: int
    title: str
    body: str
    time: str
    pinned: bool
    tags: []str
    folder: str
}

// ═══════════════════════════════════════════════════════════
// NOTES-001 v1 数据契约（实现见 src/back/repository.at）
// ═══════════════════════════════════════════════════════════

/// NoteDocument v1（r3 SQLite 时代）：inbox.db notes 行的完整文档 JSON。
/// folder 为保留旧 UI 能力的扩展字段（记录于 Spec delta）；
/// created_at/updated_at 在无后端时钟能力期间为空串（显式缺失，T-00 §4）；
/// r3 起正文为单 body 文本（v1 只产生 text 块，blocks 语法糖随 NOTES-002 再议）。
pub type NoteDocument = {
    schema_version: int
    note_id: str
    revision: int
    title: str
    body: str
    tags: []str
    color: str
    pinned: bool
    state: str
    folder: str
    created_at: str
    updated_at: str
    legacy_id: int
    seq: int
}

/// CaptureReceipt v1：request_id 幂等收据（receipts/<request_id>.json）。
/// 收据存在 ⇒ manifest 已含该提交（写入顺序保证，AC-02）。
pub type CaptureReceipt = {
    schema_version: int
    request_id: str
    note_id: str
    revision: int
    status: str
}

/// 损坏条目（迁移打捞报告用）。
pub type CorruptItem = {
    index: int
    reason: str
    snippet: str
}

/// 迁移报告（corrupted/report-r1.json 持久化同一结构）。
pub type MigrationReport = {
    attempted: bool
    migrated: int
    skipped_existing: bool
    saved: bool
    err: str
    backup_file: str
    corrupted: []CorruptItem
}

/// 仓储操作结构化结果：成功带文档/收据，失败带错误码。
/// err_code: "" | not_found | revision_conflict | storage_unwritable |
///           second_writer | corrupt | invalid_request | fault_injected
pub type RepoResult = {
    ok: bool
    err_code: str
    err_detail: str
    doc: NoteDocument
    receipt: CaptureReceipt
    replayed: bool
}

/// 宿主草稿持久行（NOTES-006 T-07 本地 scratch 面）：fp_drafts 表的类型化
/// 投影。found=false = 无槽（零值）；state ∈ idle|dirty|saving|saved|pending|
/// error|conflict（fp_host 状态机值，服务端不解释只存取）。
pub type FpDraftRow = {
    found: bool
    text: str
    state: str
    op: str
    base_rev: int
    input_ver: int
}

/// 选中笔记的来源投影（NOTES-006 T-03 来源卡数据源；主应用本地全权面——
/// 不经过 fp policy 门）。found=false = 笔记不存在；source_status =
/// ok（冻结校验过，回访入口可用）| incomplete（残缺/异构旧来源，可读、
/// 回访入口不可用）| none（无来源便签）。locator/source_json 为原文串。
pub type FpSourceView = {
    found: bool
    note_id: str
    book_id: str
    source_status: str
    title: str
    author: str
    quote: str
    locator: str
    source_json: str
}

