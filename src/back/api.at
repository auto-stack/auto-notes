// source/back/api.at - Notes API Interface
// CRUD + sort + pin + tags + search endpoints

// ═══════════════════════════════════════════════════════════
// Types (shared between frontend and backend)
// ═══════════════════════════════════════════════════════════

/// Note data model
pub type Note = {
    id: int
    title: str
    body: str
    time: str
    pinned: bool
    tags: []str
    folder: str
}

// ═══════════════════════════════════════════════════════════
// NOTES-001 v1 数据契约（实现见 src/back/repository.at）
// ═══════════════════════════════════════════════════════════

/// 正文块。v1 只产生 text 块；checklist/asset/link 随 NOTES-002 扩展。
pub type NoteBlock = {
    kind: str
    text: str
    checked: bool
}

/// NoteDocument v1：磁盘实体文件（notes/<note_id>.r<rev>.json）的完整内容。
/// 设计文档 §4 的超集：folder 为保留旧 UI 能力的扩展字段（记录于 Spec delta）；
/// created_at/updated_at 在无后端时钟能力期间为空串（显式缺失，T-00 §4）。
pub type NoteDocument = {
    schema_version: int
    note_id: str
    revision: int
    title: str
    blocks: []NoteBlock
    tags: []str
    color: str
    pinned: bool
    state: str
    folder: str
    created_at: str
    updated_at: str
    legacy_id: int
    seq: int
}

/// CaptureReceipt v1：request_id 幂等收据（receipts/<request_id>.json）。
/// 收据存在 ⇒ manifest 已含该提交（写入顺序保证，AC-02）。
pub type CaptureReceipt = {
    schema_version: int
    request_id: str
    note_id: str
    revision: int
    status: str
}

/// 损坏条目（迁移打捞报告用）。
pub type CorruptItem = {
    index: int
    reason: str
    snippet: str
}

/// 迁移报告（corrupted/report-r1.json 持久化同一结构）。
pub type MigrationReport = {
    attempted: bool
    migrated: int
    skipped_existing: bool
    saved: bool
    err: str
    backup_file: str
    corrupted: []CorruptItem
}

/// 仓储操作结构化结果：成功带文档/收据，失败带错误码。
/// err_code: "" | not_found | revision_conflict | storage_unwritable |
///           second_writer | corrupt | invalid_request | fault_injected
pub type RepoResult = {
    ok: bool
    err_code: str
    err_detail: str
    doc: NoteDocument
    receipt: CaptureReceipt
}

// ═══════════════════════════════════════════════════════════
// API Endpoints
// ═══════════════════════════════════════════════════════════

use db
use repository

// ═══════════════════════════════════════════════════════════
// NOTES-001 v1 端点（T-01/T-02 采证面；测试端点在 T-04 收尾时评估保留）
// ═══════════════════════════════════════════════════════════

/// 仓储诊断状态（条目数/计数器/打开错误/数据目录）
#[api(method = "GET", path = "/api/v1/status")]
pub fn v1_status() str {
    return db.v1_status()
}

/// 测试控制：切换隔离数据目录与旧档样本并复位进程内状态。
/// 返回 "ok" 或存储错误码。
#[api(method = "POST", path = "/api/v1/test/setup")]
pub fn v1_test_setup(data_dir str, legacy_file str) str {
    return db.v1_test_setup(data_dir, legacy_file)
}

/// 对当前 NOTES_LEGACY_FILE 执行迁移（幂等：已有 manifest 则 skipped）
#[api(method = "POST", path = "/api/v1/migrate")]
pub fn v1_migrate() MigrationReport {
    return db.v1_migrate()
}

/// 幂等创建（request_id 重放返回原对象）
#[api(method = "POST", path = "/api/v1/notes")]
pub fn v1_create_note(request_id str, title str, body str, folder str) RepoResult {
    return db.v1_create_note(request_id, title, body, folder)
}

/// 条件更新：expected_revision 不符返回 revision_conflict
#[api(method = "PUT", path = "/api/v1/notes/:nid")]
pub fn v1_update_note(nid str, expected_revision int, title str, body str, request_id str) RepoResult {
    return db.v1_update_note(nid, expected_revision, title, body, request_id)
}

/// 读取单个文档（含回收站）
#[api(method = "GET", path = "/api/v1/notes/:nid")]
pub fn v1_get_note(nid str) RepoResult {
    return db.v1_get_note(nid)
}

/// 软删除 → 回收站
#[api(method = "DELETE", path = "/api/v1/notes/:nid")]
pub fn v1_trash_note(nid str) RepoResult {
    return db.v1_trash_note(nid)
}

/// 从回收站恢复
#[api(method = "POST", path = "/api/v1/notes/:nid/restore")]
pub fn v1_restore_note(nid str) RepoResult {
    return db.v1_restore_note(nid)
}

/// active 列表（seq 降序）
#[api(method = "GET", path = "/api/v1/notes")]
pub fn v1_list_notes() []NoteDocument {
    return db.v1_list_notes()
}

/// 注入下一次提交的故障点：stage = after_journal|after_entity|after_manifest|off
#[api(method = "POST", path = "/api/v1/test/fault")]
pub fn v1_test_fault(stage str) str {
    return db.v1_test_fault(stage)
}

/// [TEMP 二分] 只做 open_repository（锁 + manifest 载入）
#[api(method = "GET", path = "/api/v1/test/open")]
pub fn v1_test_open() str {
    return db.v1_test_open()
}

/// [TEMP 二分] 只做 load_manifest_from_disk
#[api(method = "GET", path = "/api/v1/test/loadmanifest")]
pub fn v1_test_loadmanifest() str {
    return db.v1_test_loadmanifest()
}

/// [TEMP 二分] 只做 list 循环（不含 open）
#[api(method = "GET", path = "/api/v1/test/listloop")]
pub fn v1_test_listloop() int {
    return db.v1_test_listloop()
