// ═══════════════════════════════════════════════════════════
// legacy CRUD adapter（NOTES-001 r3：repository-backed）
// Note 视图映射在本模块（api → db → repository 无环链上，
// use api: Note 在此解析正常——D-742-1 仅影响 repository 直引）
// ═══════════════════════════════════════════════════════════

/// 仓储文档 JSON → legacy Note 视图（body 直读，时间缺省 "Just now"）
fn note_from_json_str(doc_json str) Note {
    var it = json.parse(doc_json)
    var v_legacy = json.get(it, "legacy_id")
    var n_id int = json.as_int(v_legacy)
    var v_rev = json.get(it, "revision")
    var n_rev int = json.as_int(v_rev)
    var v_title = json.get(it, "title")
    var n_title str = json.as_string(v_title)
    var v_body = json.get(it, "body")
    var n_body str = json.as_string(v_body)
    var v_time = json.get(it, "updated_at")
    var t str = json.as_string(v_time)
    if t == "" {
        t = "Just now"
    }
    var v_pin = json.get(it, "pinned")
    var n_pin bool = v_pin == true
    var v_tags = json.get(it, "tags")
    var v_tags_json str = json.encode(v_tags)
    var n_tags List<str> = str_list_of(v_tags_json)
    var v_folder = json.get(it, "folder")
    var n_folder str = json.as_string(v_folder)
    var n Note = Note {
        id: n_id,
        revision: n_rev,
        title: n_title,
        body: n_body,
        time: t,
        pinned: n_pin,
        tags: n_tags,
        folder: n_folder,
    }
    return n
}

/// 仓储结果信封 JSON → Note 视图（ok=true 时取 note 字段）
fn note_of_result(js str) ?Note {
    var it = json.parse(js)
    var v_ok = json.get(it, "ok")
    var okb bool = v_ok == true
    if okb {
        var v_doc = json.get(it, "note")
        var docjs str = json.encode(v_doc)
        var n Note = note_from_json_str(docjs)
        return Some(n)
    }
    return None
}

pub fn all_notes() []Note {
    var js str = repository.repo_list_active()
    var arr = json.parse(js)
    var n int = json.len(arr)
    var out List<Note> = List<Note>.new([])
    for i in 0..n {
        var it = json.get_at(arr, i)
        var ijs str = json.encode(it)
        var one Note = note_from_json_str(ijs)
        out.push(one)
    }
    return out
}

pub fn find_note(id int) ?Note {
    var js str = repository.repo_get(repository.nid_of(id))
    if js == "" {
        return None
    }
    // repo_get 返回裸文档 JSON（非信封）——直接映射 Note 视图
    var n Note = note_from_json_str(js)
    return Some(n)
}

pub fn create_note(title str, body str, folder str, request_id str) Note {
    var tags List<str> = List<str>.new([])
    var tj str = json.encode(tags)
    var rid str = request_id
    if rid == "" {
        rid = repository.ui_request_id("ui")
    }
    var js str = repository.repo_create(title, body, folder, tj, rid)
    var it = json.parse(js)
    var v_doc = json.get(it, "note")
    var docjs str = json.encode(v_doc)
    return note_from_json_str(docjs)
}

/// UI 每个草稿会话取一次稳定 request_id（重试同意图复用同一 id）
pub fn next_request_id(prefix str) str {
    return repository.ui_request_id(prefix)
}

/// 条件更新（SD-05）：expected_revision 不符 → false（服务端版本保全）；
/// request_id 由 UI 草稿会话稳定持有，重试幂等。
pub fn update_note(id int, expected_revision int, title str, body str, request_id str) bool {
    var nid str = repository.nid_of(id)
    var rid str = request_id
    if rid == "" {
        rid = repository.ui_request_id("ui-upd")
    }
    var js str = repository.repo_update(nid, expected_revision, title, body, rid)
    var it = json.parse(js)
    var v_ok = json.get(it, "ok")
    return v_ok == true
}

/// 条件更新（结构化结果版，SD-14/T-19）：UI 需要 err_code 区分「明确拒绝」
/// （revision_conflict/request_conflict——请求未执行）与「传输层未知结果」
/// （err_code 空——可能已提交，需按未确认提交裁决）。
pub fn update_note_r(id int, expected_revision int, title str, body str, request_id str) RepoResult {
    var nid str = repository.nid_of(id)
    var rid str = request_id
    if rid == "" {
        rid = repository.ui_request_id("ui-upd")
    }
    var js str = repository.repo_update(nid, expected_revision, title, body, rid)
    return repo_result_of(js)
}

/// 读取单个文档（结构化结果版，SD-14/T-19）：未确认提交裁决时取服务器
/// 当前 revision/内容对比（?Note 的 unwrap 在两侧生成码里非既证原语，
/// 走 RepoResult 信封与既有解析路径同构）。
pub fn get_note_r(id int) RepoResult {
    var js str = repository.repo_get(repository.nid_of(id))
    if js == "" {
        return repo_result_of("{\"ok\":false,\"err_code\":\"not_found\"}")
    }
    var env_js str = "{\"ok\":true,\"err_code\":\"\",\"note\":" + js + ",\"receipt\":{\"schema_version\":1,\"request_id\":\"\",\"note_id\":\"\",\"revision\":0,\"status\":\"\"}}"
    return repo_result_of(env_js)
}

pub fn delete_note(id int) bool {
    var js str = repository.repo_trash(repository.nid_of(id))
    var it = json.parse(js)
    var v_ok = json.get(it, "ok")
    return v_ok == true
}

pub fn toggle_pin(id int) ?Note {
    var nid str = repository.nid_of(id)
    var cur_js str = repository.repo_get(nid)
    if cur_js == "" {
        return None
    }
    var cur = json.parse(cur_js)
    var v_pin = json.get(cur, "pinned")
    var pb bool = v_pin == true
    var want bool = true
    if pb {
        want = false
    }
    var js str = repository.repo_set_pinned(nid, want)
    return note_of_result(js)
}

pub fn update_tags(id int, tags []str) ?Note {
    var nid str = repository.nid_of(id)
    var tj str = json.encode(tags)
    var js str = repository.repo_set_tags(nid, tj)
    return note_of_result(js)
}

/// 置顶切换（结构化结果版，F-R9-01）：保持 toggle_pin 的取反语义，
/// 失败经 RepoResult 信封返回，不让框架把 None 映射成 HTTP 404。
pub fn toggle_pin_result(id int) RepoResult {
    var nid str = repository.nid_of(id)
    var cur_js str = repository.repo_get(nid)
    if cur_js == "" {
        return repo_result_of("{\"ok\":false,\"err_code\":\"not_found\"}")
    }
    var cur = json.parse(cur_js)
    var v_pin = json.get(cur, "pinned")
    var pb bool = v_pin == true
    var want bool = true
    if pb {
        want = false
    }
    var js str = repository.repo_set_pinned(nid, want)
    return repo_result_of(js)
}

/// 标签更新（结构化结果版，F-R9-01）。
pub fn update_tags_result(id int, tags []str) RepoResult {
    var nid str = repository.nid_of(id)
    var tj str = json.encode(tags)
    var js str = repository.repo_set_tags(nid, tj)
    return repo_result_of(js)
}

pub fn search_notes(query str) []Note {
    var js str = repository.repo_search(query)
    var arr = json.parse(js)
    var n int = json.len(arr)
    var out List<Note> = List<Note>.new([])
    for i in 0..n {
        var it = json.get_at(arr, i)
        var ijs str = json.encode(it)
        var one Note = note_from_json_str(ijs)
        out.push(one)
    }
    return out
}

// ═══════════════════════════════════════════════════════════
// FeaturePack v0（NOTES-006 T-02）：notes.fpack/1 wire 门 + 委托。
// 版本拒绝（业务前，契约 §2.2）：interface_version ≠ notes.fpack/1 →
// unsupported_version，不触仓储。凭据/作用域/去重/事务在 repository.fp_*。
// 授权书语义：fp 端点面向外部宿主（按 policy 文件裁剪）；主应用自有
// 路径（/api/notes*）不经过本门，数据归属不变。
// ═══════════════════════════════════════════════════════════

/// 接口版本串（wire 门与健康探针同源；const 语法会使 VM 面解析中断——
/// T-03 实测，fn 形态替代）。
pub fn fp_interface_version() str {
    return "notes.fpack/1"
}

fn fp_version_gate(interface_version str) str {
    if interface_version != fp_interface_version() {
        return "{\"ok\":false,\"err_code\":\"unsupported_version\"}"
    }
    return ""
}

pub fn fp_attempt_gate(attempt_id str) str {
    if attempt_id == "" {
        return "{\"ok\":false,\"err_code\":\"invalid_request\",\"err_detail\":\"attempt_id required (per-attempt, distinct from operation_id)\"}"
    }
    return ""
}

/// 就绪探针体（daemon ensure 链固定契约；版本就绪核验读 interface 字段）
pub fn fp_health() str {
    return "{\"status\":\"ok\",\"interface\":\"notes.fpack/1\"}"
}

pub fn fp_capture(cred str, interface_version str, attempt_id str, operation_id str, source_json str, text str) str {
    var g1 str = fp_version_gate(interface_version)
    if g1 != "" {
        return g1
    }
    var g2 str = fp_attempt_gate(attempt_id)
    if g2 != "" {
        return g2
    }
    return repository.fp_capture(cred, operation_id, source_json, text)
}

pub fn fp_get_note(cred str, interface_version str, note_id str) str {
    var g1 str = fp_version_gate(interface_version)
    if g1 != "" {
        return g1
    }
    return repository.fp_get(cred, note_id)
}

pub fn fp_list_by_book(cred str, interface_version str, book_id str, cursor int, limit int) str {
    var g1 str = fp_version_gate(interface_version)
    if g1 != "" {
        return g1
    }
    return repository.fp_list_by_book(cred, book_id, cursor, limit)
}

pub fn fp_update_note(cred str, interface_version str, attempt_id str, note_id str, expected_revision int, text str, operation_id str) str {
    var g1 str = fp_version_gate(interface_version)
    if g1 != "" {
        return g1
    }
    var g2 str = fp_attempt_gate(attempt_id)
    if g2 != "" {
        return g2
    }
    return repository.fp_update(cred, note_id, expected_revision, text, operation_id)
}

pub fn fp_receipt(cred str, interface_version str, operation_id str) str {
    var g1 str = fp_version_gate(interface_version)
    if g1 != "" {
        return g1
    }
    return repository.fp_receipt(cred, operation_id)
}

