// source/back/db.at - Notes 服务层（NOTES-001 T-04：legacy CRUD → 仓储 adapter）
//
// 全部持久化经 src/back/repository.at（journal → 实体 → manifest → 收据）。
// 本文件做两件事：① v1 端点服务层；② legacy Note 视图适配（整数 id /
// body 字符串 ← NoteDocument），供 api.at 的 legacy 端点直调。
// 旧内存 CRUD 退役；folders 是笔记级元数据（NoteDocument.folder）。

use api: NoteDocument
use api: MigrationReport
use api: RepoResult
use auto.env

use repository

// ═══════════════════════════════════════════════════════════
// NOTES-001 v1 端点服务层
// ═══════════════════════════════════════════════════════════

pub fn v1_status() str {
    return repository.repo_status()
}

pub fn v1_test_setup(data_dir str, legacy_file str) str {
    env.set("NOTES_DATA_DIR", data_dir)
    env.set("NOTES_LEGACY_FILE", legacy_file)
    repository.test_reset()
    return "ok"
}

pub fn v1_migrate() MigrationReport {
    var legacy str = env.get("NOTES_LEGACY_FILE")
    if legacy == "" {
        var d str = repository.data_dir()
        legacy = d + "/notes.json"
    }
    return repository.migrate_legacy_at(legacy.as_str())
}

pub fn v1_create_note(request_id str, title str, body str, folder str) RepoResult {
    var tags List<str> = List<str>.new([])
    return repository.repo_create(title, body, folder, tags, request_id.as_str())
}

pub fn v1_update_note(nid str, expected_revision int, title str, body str, request_id str) RepoResult {
    return repository.repo_update(nid, expected_revision, title, body, request_id)
}

pub fn v1_get_note(nid str) RepoResult {
    return repository.repo_get(nid)
}

pub fn v1_trash_note(nid str) RepoResult {
    return repository.repo_trash(nid)
}

pub fn v1_restore_note(nid str) RepoResult {
    return repository.repo_restore(nid)
}

pub fn v1_list_notes() []NoteDocument {
    return repository.repo_list_active()
}

pub fn v1_test_open() str {
    return repository.open_repository()
}

pub fn v1_test_loadmanifest() str {
    var ok bool = repository.test_load_manifest()
    if ok {
        return "loaded"
    }
    return "load-failed"
}

pub fn v1_test_listloop() int {
    return repository.test_list_once()
}

pub fn v1_test_fault(stage str) str {
    if stage == "off" {
        env.set("NOTES_FAULT", "")
        return "off"
    }
    env.set("NOTES_FAULT", stage)
    return stage
}

// ═══════════════════════════════════════════════════════════
// legacy 端点同名函数（生成器混合状态防护的名字匹配要求；
// api.at 的 handler 体直调 repository，本组满足存在性检查）
// ═══════════════════════════════════════════════════════════

pub fn all_notes() []NoteDocument {
    return repository.repo_list_active()
}

pub fn find_note(id int) RepoResult {
    return repository.repo_get(repository.nid_of(id))
}

pub fn create_note(title str, body str, folder str) RepoResult {
    var tags List<str> = List<str>.new([])
    return repository.repo_create(title, body, folder, tags, repository.ui_request_id("ui"))
}

pub fn update_note(id int, title str, body str) RepoResult {
    return repository.repo_get(repository.nid_of(id))
}

pub fn delete_note(id int) bool {
    var r = repository.repo_trash(repository.nid_of(id))
    return r.ok
}

pub fn toggle_pin(id int) RepoResult {
    return repository.repo_get(repository.nid_of(id))
}

pub fn update_tags(id int, tags []str) RepoResult {
    return repository.repo_set_tags(repository.nid_of(id), tags)
}

pub fn search_notes(query str) []NoteDocument {
    return repository.repo_search(query)
}
