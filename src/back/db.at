// api.at 的 handler 体直调 repository，本组满足存在性检查）
// ═══════════════════════════════════════════════════════════

// Plan 742/T-05: SQLite 能力探针端点的同名委托（api.at 端点名字匹配要求）
pub fn p2_open() str {
    return p2probe.open_probe()
}

pub fn p2_txn() str {
    return p2probe.txn_probe()
}

pub fn p2_busy() str {
    return p2probe.busy_probe()
}

pub fn p2_rollback() str {
    return p2probe.rollback_probe()
}

pub fn p2_escape() str {
    return p2probe.escape_probe()
}

// ═══════════════════════════════════════════════════════════
// legacy CRUD adapter（NOTES-001 r3：repository-backed）
// Note 视图映射在本模块（api → db → repository 无环链上，
// use api: Note 在此解析正常——D-742-1 仅影响 repository 直引）
// ═══════════════════════════════════════════════════════════

/// 仓储文档 JSON → legacy Note 视图（body 直读，时间缺省 "Just now"）
fn note_from_json_str(doc_json str) Note {
    var it = json.parse(doc_json)
    var v_legacy = json.get(it, "legacy_id")
    var n_id int = json.as_int(v_legacy)
    var v_rev = json.get(it, "revision")
    var n_rev int = json.as_int(v_rev)
    var v_title = json.get(it, "title")
    var n_title str = json.as_string(v_title)
    var v_body = json.get(it, "body")
    var n_body str = json.as_string(v_body)
    var v_time = json.get(it, "updated_at")
    var t str = json.as_string(v_time)
    if t == "" {
        t = "Just now"
    }
    var v_pin = json.get(it, "pinned")
    var n_pin bool = json.as_bool(v_pin)
    var v_tags = json.get(it, "tags")
    var v_tags_json str = json.encode(v_tags)
    var n_tags List<str> = str_list_of(v_tags_json)
    var v_folder = json.get(it, "folder")
    var n_folder str = json.as_string(v_folder)
    var n Note = Note {
        id: n_id,
        revision: n_rev,
        title: n_title,
        body: n_body,
        time: t,
        pinned: n_pin,
        tags: n_tags,
        folder: n_folder,
    }
    return n
}

/// 仓储结果信封 JSON → Note 视图（ok=true 时取 note 字段）
fn note_of_result(js str) ?Note {
    var it = json.parse(js)
    var v_ok = json.get(it, "ok")
    var okb bool = json.as_bool(v_ok)
    if okb {
        var v_doc = json.get(it, "note")
        var docjs str = json.encode(v_doc)
        var n Note = note_from_json_str(docjs)
        return Some(n)
    }
    return None
}

pub fn all_notes() []Note {
    var js str = repository.repo_list_active()
    var arr = json.parse(js)
    var n int = json.len(arr)
    var out List<Note> = List<Note>.new([])
    for i in 0..n {
        var it = json.get_at(arr, i)
        var ijs str = json.encode(it)
        var one Note = note_from_json_str(ijs)
        out.push(one)
    }
    return out
}

pub fn find_note(id int) ?Note {
    var js str = repository.repo_get(repository.nid_of(id))
    if js == "" {
        return None
    }
    // repo_get 返回裸文档 JSON（非信封）——直接映射 Note 视图
    var n Note = note_from_json_str(js)
    return Some(n)
}

pub fn create_note(title str, body str, folder str, request_id str) Note {
    var tags List<str> = List<str>.new([])
    var tj str = json.encode(tags)
    var rid str = request_id
    if rid == "" {
        rid = repository.ui_request_id("ui")
    }
    var js str = repository.repo_create(title, body, folder, tj, rid)
    var it = json.parse(js)
    var v_doc = json.get(it, "note")
    var docjs str = json.encode(v_doc)
    return note_from_json_str(docjs)
}

/// UI 每个草稿会话取一次稳定 request_id（重试同意图复用同一 id）
pub fn next_request_id(prefix str) str {
    return repository.ui_request_id(prefix)
}

/// 条件更新（SD-05）：expected_revision 不符 → false（服务端版本保全）；
/// request_id 由 UI 草稿会话稳定持有，重试幂等。
pub fn update_note(id int, expected_revision int, title str, body str, request_id str) bool {
    var nid str = repository.nid_of(id)
    var rid str = request_id
    if rid == "" {
        rid = repository.ui_request_id("ui-upd")
    }
    var js str = repository.repo_update(nid, expected_revision, title, body, rid)
    var it = json.parse(js)
    var v_ok = json.get(it, "ok")
    return json.as_bool(v_ok)
}

pub fn delete_note(id int) bool {
    var js str = repository.repo_trash(repository.nid_of(id))
    var it = json.parse(js)
    var v_ok = json.get(it, "ok")
    return json.as_bool(v_ok)
}

pub fn toggle_pin(id int) ?Note {
    var nid str = repository.nid_of(id)
    var cur_js str = repository.repo_get(nid)
    if cur_js == "" {
        return None
    }
    var cur = json.parse(cur_js)
    var v_pin = json.get(cur, "pinned")
    var pb bool = json.as_bool(v_pin)
    var want bool = true
    if pb {
        want = false
    }
    var js str = repository.repo_set_pinned(nid, want)
    return note_of_result(js)
}

pub fn update_tags(id int, tags []str) ?Note {
    var nid str = repository.nid_of(id)
    var tj str = json.encode(tags)
    var js str = repository.repo_set_tags(nid, tj)
    return note_of_result(js)
}

pub fn search_notes(query str) []Note {
    var js str = repository.repo_search(query)
    var arr = json.parse(js)
    var n int = json.len(arr)
    var out List<Note> = List<Note>.new([])
    for i in 0..n {
        var it = json.get_at(arr, i)
        var ijs str = json.encode(it)
        var one Note = note_from_json_str(ijs)
        out.push(one)
    }
    return out
}
