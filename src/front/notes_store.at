        // 标签动作基于服务器当前版本执行；dirty 先 flush，失败时动作继续但
        // **绝不清草稿**（LoadDraft 由 dirty 守卫挡住）——F-R4-04 主诉。
        // 标签动作（SD-26/T-31）：目标绑定草稿身份（恢复目标不在工作集时
        // 不得改另一行）；flush 意图轮换+裁决；冲突动作继续但绝不清草稿。
        .TagAdded(t) -> {
            if .draft_id != 0 {
                if .dirty {
                    if .has_pend {
                        if .draft_title != .pend_title {
                            if .has_prev {
                                .has_prev2 = true
                                .prev2_title = .prev_title
                                .prev2_body = .prev_body
                            }
                            .has_prev = true
                            .prev_title = .pend_title
                            .prev_body = .pend_body
                            .draft_request_id = next_request_id("ui-edit2")
                            .BindIntent()
                        } else {
                            if .draft_body != .pend_body {
                                if .has_prev {
                                    .has_prev2 = true
                                    .prev2_title = .prev_title
                                    .prev2_body = .prev_body
                                }
                                .has_prev = true
                                .prev_title = .pend_title
                                .prev_body = .pend_body
                                .draft_request_id = next_request_id("ui-edit2")
                                .BindIntent()
                            }
                        }
                    }
                    if .draft_request_id == "" {
                        .draft_request_id = next_request_id("ui-edit")
                        .BindIntent()
                    }
                    var fr2 RepoResult = update_note_r(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id)
                    var saved2 bool = fr2.ok
                    if saved2 == false {
                        .conflict = true
                        var adj bool = false
                        if fr2.err_code == "revision_conflict" {
                            adj = true
                        } else {
                            if fr2.err_code == "request_conflict" {
                                adj = true
                            }
                        }
                        if adj {
                            if .has_prev {
                                var srv RepoResult = get_note_r(.draft_id)
                                if srv.ok {
                                    var matched bool = false
                                    if srv.doc.title == .prev_title {
                                        if srv.doc.body == .prev_body {
                                            matched = true
                                        }
                                    }
                                    if matched == false {
                                        if .has_prev2 {
                                            if srv.doc.title == .prev2_title {
                                                if srv.doc.body == .prev2_body {
                                                    matched = true
                                                }
                                            }
                                        }
                                    }
                                    if matched {
                                        .draft_revision = srv.doc.revision
                                        .has_prev = false
                                        .has_prev2 = false
                                        .BindIntent()
                                        var r2 RepoResult = update_note_r(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id)
                                        if r2.ok {
                                            saved2 = true
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if saved2 {
                        .dirty = false
                        .conflict = false
                        .draft_request_id = ""
                        .has_pend = false
                        .has_prev = false
                        .has_prev2 = false
                    }
                }
                var tl []str = []
                var exists bool = false
                for tg in .draft_tags {
                    if tg == t {
                        exists = true
                    }
                    tl.push(tg)
                }
                if exists == false {
                    tl.push(t)
                }
                update_tags(.draft_id, tl)
                var dup bool = false
                for e in .all_tags {
                    if e == t {
                        dup = true
                    }
                }
                if dup == false {
                    .all_tags.push(t)
                }
                if .search == "" {
                    .notes = list_notes()
                } else {
                    .notes = search_notes(.search)
                }
                .LoadDraft()
                .ApplyFilter()
            }
        }

        .TagRemoved(t) -> {
            if .draft_id != 0 {
                if .dirty {
                    if .has_pend {
                        if .draft_title != .pend_title {
                            if .has_prev {
                                .has_prev2 = true
                                .prev2_title = .prev_title
                                .prev2_body = .prev_body
                            }
                            .has_prev = true
                            .prev_title = .pend_title
                            .prev_body = .pend_body
                            .draft_request_id = next_request_id("ui-edit2")
                            .BindIntent()
                        } else {
                            if .draft_body != .pend_body {
                                if .has_prev {
                                    .has_prev2 = true
                                    .prev2_title = .prev_title
                                    .prev2_body = .prev_body
                                }
                                .has_prev = true
                                .prev_title = .pend_title
                                .prev_body = .pend_body
                                .draft_request_id = next_request_id("ui-edit2")
                                .BindIntent()
                            }
                        }
                    }
                    if .draft_request_id == "" {
                        .draft_request_id = next_request_id("ui-edit")
                        .BindIntent()
                    }
                    var fr2 RepoResult = update_note_r(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id)
                    var saved2 bool = fr2.ok
                    if saved2 == false {
                        .conflict = true
                        var adj bool = false
                        if fr2.err_code == "revision_conflict" {
                            adj = true
                        } else {
                            if fr2.err_code == "request_conflict" {
                                adj = true
                            }
                        }
                        if adj {
                            if .has_prev {
                                var srv RepoResult = get_note_r(.draft_id)
                                if srv.ok {
                                    var matched bool = false
                                    if srv.doc.title == .prev_title {
                                        if srv.doc.body == .prev_body {
                                            matched = true
                                        }
                                    }
                                    if matched == false {
                                        if .has_prev2 {
                                            if srv.doc.title == .prev2_title {
                                                if srv.doc.body == .prev2_body {
                                                    matched = true
                                                }
                                            }
                                        }
                                    }
                                    if matched {
                                        .draft_revision = srv.doc.revision
                                        .has_prev = false
                                        .has_prev2 = false
                                        .BindIntent()
                                        var r2 RepoResult = update_note_r(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id)
                                        if r2.ok {
                                            saved2 = true
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if saved2 {
                        .dirty = false
                        .conflict = false
                        .draft_request_id = ""
                        .has_pend = false
                        .has_prev = false
                        .has_prev2 = false
                    }
                }
                var tl []str = []
                for tg in .draft_tags {
                    if tg != t {
                        tl.push(tg)
                    }
                }
                update_tags(.draft_id, tl)
                if .search == "" {
                    .notes = list_notes()
                } else {
                    .notes = search_notes(.search)
                }
                .LoadDraft()
                .ApplyFilter()
            }
        }

        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }

        // 显式模式（外观面板 Dark/Light 两键）——走 ToggleDarkMode 保持
        // applyAccent 重放（T12-DARK 契约）。
        .SetMode(m) -> {
            if m == "dark" {
                if .dark_mode == false {
                    .ToggleDarkMode()
                }
            } else {
                if .dark_mode == true {
                    .ToggleDarkMode()
                }
            }
        }

        .SetAccent(name) -> {
            .accent_color = name
        }

        .ToggleSettings -> {
            .show_settings = !.show_settings
        }
    }
}
