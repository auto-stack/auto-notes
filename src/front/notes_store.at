        .ClearTag -> {
            var flushed bool = true
            if .dirty {
                if .has_pend {
                    if .draft_title != .pend_title {
                        if .has_prev {
                            .has_prev2 = true
                            .prev2_title = .prev_title
                            .prev2_body = .prev_body
