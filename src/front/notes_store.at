                                .prev2_title = .prev_title
                                .prev2_body = .prev_body
                            }
                            .has_prev = true
                            .prev_title = .pend_title
                            .prev_body = .pend_body
                            .draft_request_id = next_request_id("ui-edit2")
                            .BindIntent()
                        }
                    }
                }
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                    .BindIntent()
                }
                var fr RepoResult = update_note_r(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id)
                var saved bool = fr.ok
                if saved == false {
                    .conflict = true
                    var adj bool = false
                    if fr.err_code == "revision_conflict" {
                        adj = true
                    } else {
                        if fr.err_code == "request_conflict" {
                            adj = true
                        }
                    }
                    if adj {
                        if .has_prev {
                            var srv RepoResult = get_note_r(.draft_id)
                            if srv.ok {
                                var matched bool = false
                                if srv.doc.title == .prev_title {
                                    if srv.doc.body == .prev_body {
                                        matched = true
                                    }
                                }
                                if matched == false {
                                    if .has_prev2 {
                                        if srv.doc.title == .prev2_title {
                                            if srv.doc.body == .prev2_body {
                                                matched = true
                                            }
                                        }
                                    }
                                }
                                if matched {
                                    .draft_revision = srv.doc.revision
                                    .has_prev = false
                                    .has_prev2 = false
                                    .BindIntent()
                                    var r2 RepoResult = update_note_r(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id)
                                    if r2.ok {
                                        saved = true
                                    }
                                }
                            }
                        }
                    }
                }
                if saved {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    .has_pend = false
                    .has_prev = false
                    .has_prev2 = false
                    if .search == "" {
                        .notes = list_notes()
                    } else {
                        .notes = search_notes(.search)
                    }
                } else {
                    .StashDraft()
                    if .stash_blocked {
                        flushed = false
                    } else {
                        .dirty = false
                    }
                }
            }
            if flushed {
                .active_tag = ""
                .ApplyFilter()
                .SelectFirstVisible()
            }
