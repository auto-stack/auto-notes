// notes_store.at — 015-notes 单一状态源（PLAN-616 清爽化重做 + NOTES-001 r4 T-15）。
//
// 设计要点（依据 PLAN-616 §4.2 在真实后端数据上的能力探针）：
//
// 1. 筛选一律在 store 里算成「可见索引表」（[]int，指向 .notes 下标），视图只做
//    索引解引用。原因：视图条件里的方法调用（`if note.tags.contains(x)`）在 VM 端
//    走 `resolve_binding_path`，该函数只做逐段字段访问、不认识方法调用 → 条件恒假
//    （PLAN-616 U5；旧实现 sidebar.at 的标签过滤分支从未生效）。
//
// 2. 只使用在 VM 上实证可用的原语：[]int 局部量 + push、`idx = idx + 1`、嵌套 for、
//    字段比较 == / !=、API 调用。**禁用**：`.field = []`、以及把局部 []str/[]Note
//    赋给状态字段——两者都会撞上 `vm/codegen.rs` 的 "Assignment to complex LHS"
//    panic（PLAN-616 §4.2）。
//
// 3. 搜索借后端 `search_notes`（其内部走 to_lower，故大小写不敏感）直接替换 .notes
//    工作集，而不是在视图里逐条比对；空查询时回到全量。
//
// 4. 草稿常驻 store（draft_*）：切换笔记/筛选/新建前先落盘，避免「编辑中被切走丢内容」，
//    并让「始终可编辑」不需要模态 Edit/Save 切换。
//
// 5. **入口 handler 把 API 调用内联在自身 body 里**（不抽 `ReloadNotes()` / `FlushDraft()`
//    这类会发请求的兄弟方法再串行调用）。原因：生成器只把「body 里出现 await」的 store
//    方法标成 async；同步方法调用 async 兄弟方法不会 await（Vue 端），后续同步步骤会先跑
//    并读到旧数据——实证：搜索在 Vue 端完全不过滤（VM 端 merged 模式调用同步，无此问题，
//    所以只在 Vue 侧暴露）。纯同步小工具（ApplyFilter / LoadDraft / SelectFirstVisible /
//    SeedVocab）仍可自由复用。
//
// 6. **r4 SD-10（T-15/F-R4-04）**：
//    - 编辑意图稳定非空 rid：首次 EditTitle/EditBody 即取 next_request_id 并在整个草稿
//      会话持有；保存失败/响应丢失后原样重试 = 同一意图（服务端按意图重放幂等）。
//    - 任何动作（标签/置顶/筛选/切换/搜索/新建）在 flush 失败/冲突时**绝不**清
//      draft/dirty、**绝不**用 LoadDraft 覆盖草稿；冲突下的导航把失败草稿存入恢复槽
//      （has_recovery）后照常继续——本地与服务器版本都可恢复。
//    - flush 成功后刷新 notes/revision 再 LoadDraft（防旧正文冒充已保存，F-R4-04 P2）。
//    - create 返回 id==0 视为失败，不冒充成功选中空笔记。

use back.api: list_notes, create_note, update_note, delete_note, toggle_pin, update_tags, search_notes, next_request_id

store NotesStore {
    model {
        // 工作集：搜索时是命中集，否则是全量（其余筛选只影响可见索引表）
        var notes []Note = []
        var active_id int = 0

        // 筛选状态：active_folder = "all" | "pinned" | 具体文件夹名
        var search str = ""
        var active_folder str = "all"
        var active_tag str = ""

        // 可见索引表（见文件头 ①）
        var visible_pinned []int = []
        var visible_notes []int = []

        // 标签 / 文件夹词表。模型字段而非 computed：旧写法 `computed all_tags => []` 恒空，
        // 让筛选区那一行永远渲染成空白占位（PLAN-616 U4）。
        var all_tags []str = []
        var all_folders []str = []

        // 草稿（见文件头 ④）
        var draft_id int = 0
        var draft_revision int = 0
        var draft_title str = ""
        var draft_body str = ""
        var draft_time str = ""
        var draft_folder str = ""
        var draft_pinned bool = false
        // SD-05/10：草稿会话的稳定请求意图（首次编辑即取非空 id，durable 后清；
        // 失败/冲突保留 → 原样重试同一意图幂等）。conflict=true = 上次保存被拒。
        var draft_request_id str = ""
        var conflict bool = false
        // 标签单独镜像一份：视图遍历 .store.draft_tags 比下标点路径可靠。
        var draft_tags []str = []
        var dirty bool = false
        var confirm_delete bool = false

        // 恢复槽（SD-10）：冲突下导航时，失败草稿整体入槽，可恢复/放弃。
        var has_recovery bool = false
        var rec_id int = 0
        var rec_revision int = 0
        var rec_title str = ""
        var rec_body str = ""
        var rec_time str = ""
        var rec_folder str = ""
        var rec_pinned bool = false
        var rec_tags []str = []
        var rec_request_id str = ""

        // 主题（沿用 PLAN-360/458/601 机制：store 持有，负责 applyAccent 重放）
        var dark_mode bool = true
        var accent_color str = "indigo"
        var show_settings bool = false
    }

    msg {
        Init, SeedVocab, ApplyFilter, LoadDraft, SelectFirstVisible,
        SelectNote(int), NewNote, SaveDraft,
        EditTitle(str), EditBody(str),
        DeleteArmed, DeleteConfirmed, DeleteCancelled, TogglePin(int), TogglePinActive,
        SetSearch(str), SelectFolder(str), SelectTag(str), ClearTag,
        TagAdded(str), TagRemoved(str),
        StashDraft, RecoverDraft, DiscardRecovery, DiscardDraft,
        ToggleDarkMode, SetMode(str), SetAccent(str), ToggleSettings
    }

    on {
        // ── 初始化：body 里自带 await（list_notes），后续步骤顺序可靠 ─────────
        .Init -> {
            .search = ""
            .active_folder = "all"
            .active_tag = ""
            .notes = list_notes()
            .SeedVocab()
            .active_id = 0
            .LoadDraft()
            .ApplyFilter()
        }

        // ── 纯同步工具族（无 API 调用，可被任何 handler 复用）─────────────────

        // 标签 / 文件夹词表播种：嵌套 for + 逐项扫描去重（不用 contains，见文件头 ②）。
        .SeedVocab -> {
            var dup bool = false
            for n in .notes {
                for t in n.tags {
                    dup = false
                    for e in .all_tags {
                        if e == t {
                            dup = true
                        }
                    }
                    if dup == false {
                        .all_tags.push(t)
                    }
                }
                if n.folder != "" {
                    dup = false
                    for e in .all_folders {
                        if e == n.folder {
                            dup = true
                        }
                    }
                    if dup == false {
                        .all_folders.push(n.folder)
                    }
                }
            }
        }

        // 可见索引表：作用域 + 标签两个维度，单趟扫描产出两组下标。
        .ApplyFilter -> {
            var pinned []int = []
            var plain []int = []
            var ok bool = false
            var idx int = 0
            for n in .notes {
                ok = false
                if .active_folder == "all" {
                    ok = true
                } else if .active_folder == "pinned" {
                    if n.pinned {
                        ok = true
                    }
                } else if n.folder == .active_folder {
                    ok = true
                }
                if ok {
                    if .active_tag != "" {
                        ok = false
                        for t in n.tags {
                            if t == .active_tag {
                                ok = true
                            }
                        }
                    }
                }
                if ok {
                    if n.pinned {
                        pinned.push(idx)
                    } else {
                        plain.push(idx)
                    }
                }
                idx = idx + 1
            }
            .visible_pinned = pinned
            .visible_notes = plain
        }

        // LoadDraft 只在无未保存内容时装载（SD-10：冲突/草稿保护期绝不覆盖草稿）。
        .LoadDraft -> {
            if .dirty == false {
                if .notes.len() > 0 {
                    .draft_id = .notes[.active_id].id
                    .draft_revision = .notes[.active_id].revision
                    .draft_title = .notes[.active_id].title
                    .draft_body = .notes[.active_id].body
                    .draft_time = .notes[.active_id].time
                    .draft_folder = .notes[.active_id].folder
                    .draft_pinned = .notes[.active_id].pinned
                    .draft_tags = .notes[.active_id].tags
                } else {
                    // 空数组字面量赋值会撞 VM codegen panic（文件头 ②），只清标量。
                    .draft_id = 0
                    .draft_revision = 0
                    .draft_title = ""
                    .draft_body = ""
                    .draft_time = ""
                    .draft_folder = ""
                    .draft_pinned = false
                }
                .draft_request_id = ""
                .conflict = false
            }
            .confirm_delete = false
        }

        // 切换作用域后把选中项落到第一条可见笔记。
        .SelectFirstVisible -> {
            if .visible_pinned.len() > 0 {
                .active_id = .visible_pinned[0]
            } else if .visible_notes.len() > 0 {
                .active_id = .visible_notes[0]
            }
            .LoadDraft()
        }

        // ── 恢复槽（SD-10）─────────────────────────────────────────────────

        // 当前编辑器内容入恢复槽（单槽，后入覆盖）。
        .StashDraft -> {
            .has_recovery = true
            .rec_id = .draft_id
            .rec_revision = .draft_revision
            .rec_title = .draft_title
            .rec_body = .draft_body
            .rec_time = .draft_time
            .rec_folder = .draft_folder
            .rec_pinned = .draft_pinned
            .rec_tags = .draft_tags
            .rec_request_id = .draft_request_id
        }

        // 恢复：回到该笔记（列表找得到时）并装载草稿；dirty/conflict 复原，
        // 同 rid 原样重试。
        .RecoverDraft -> {
            if .dirty {
                .StashDraft()
            }
            var found bool = false
            var i int = 0
            for n in .notes {
                if n.id == .rec_id {
                    .active_id = i
                    found = true
                }
                i = i + 1
            }
            .draft_id = .rec_id
            .draft_revision = .rec_revision
            .draft_title = .rec_title
            .draft_body = .rec_body
            .draft_time = .rec_time
            .draft_folder = .rec_folder
            .draft_pinned = .rec_pinned
            .draft_tags = .rec_tags
            .draft_request_id = .rec_request_id
            .dirty = true
            .conflict = true
            .has_recovery = false
            .ApplyFilter()
        }

        .DiscardRecovery -> {
            .has_recovery = false
        }

        // 放弃当前草稿 = 显式选择服务器版本。
        .DiscardDraft -> {
            .dirty = false
            .conflict = false
            .draft_request_id = ""
            .LoadDraft()
            .ApplyFilter()
        }

        // ── 入口 handler（API 调用内联，见文件头 ⑤）────────────────────────

        // 冲突下导航不被阻止：失败草稿入恢复槽后照常切换（SD-10）。
        .SelectNote(i) -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    if .search == "" {
                        .notes = list_notes()
                    } else {
                        .notes = search_notes(.search)
                    }
                    .active_id = i
                    .LoadDraft()
                } else {
                    .conflict = true
                    .StashDraft()
                    .dirty = false
                    .active_id = i
                    .LoadDraft()
                }
            } else {
                .active_id = i
                .LoadDraft()
            }
        }

        // 编辑意图（SD-10）：rid 在**保存点**获取（见 flush 位）——输入事件
        // handler 保持同步（VM/MCP action 等待路径上内联 HTTP 会撞调度死锁，
        // 实证：type_text 触发 EditTitle→next_request_id 的 HttpRequest 与
        // execute_action_vnode 的完成等待互等）。rid 一经分配贯穿整个草稿
        // 会话：丢响应后原样重试 = 同一意图，幂等恢复。
        .EditTitle(v) -> {
            .draft_title = v
            .dirty = true
        }

        .EditBody(v) -> {
            .draft_body = v
            .dirty = true
        }

        .SaveDraft -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    if .search == "" {
                        .notes = list_notes()
                    } else {
                        .notes = search_notes(.search)
                    }
                    .LoadDraft()
                    .ApplyFilter()
                } else {
                    // 冲突/失败：草稿保留（dirty 保持），Save 仍在——丢响应场景
                    // 原样重试即恢复（同 rid 幂等）；真冲突可「放弃」选服务器版。
                    .conflict = true
                }
            } else {
                .conflict = false
            }
        }

        .NewNote -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    if .search == "" {
                        .notes = list_notes()
                    } else {
                        .notes = search_notes(.search)
                    }
                } else {
                    .conflict = true
                    .StashDraft()
                    .dirty = false
                }
            }
            if .conflict == false {
                // 清掉搜索：新笔记标题为空，有搜索词时看不见
                .search = ""
                var f str = ""
                if .active_folder != "all" {
                    if .active_folder != "pinned" {
                        f = .active_folder
                    }
                }
                var rid str = next_request_id("ui-new")
                var created Note = create_note("", "", f, rid)
                if created.id == 0 {
                    // 创建失败不冒充成功（SD-10）
                    .conflict = true
                } else {
                    .notes = list_notes()
                    .active_id = 0
                    .LoadDraft()
                    .ApplyFilter()
                }
            }
        }

        // 删除两步：先武装确认，再确认才真删。
        .DeleteArmed -> {
            .confirm_delete = true
        }

        .DeleteCancelled -> {
            .confirm_delete = false
        }

        .DeleteConfirmed -> {
            if .notes.len() > 0 {
                delete_note(.notes[.active_id].id)
                if .search == "" {
                    .notes = list_notes()
                } else {
                    .notes = search_notes(.search)
                }
                .active_id = 0
                .LoadDraft()
                .ApplyFilter()
            }
            .confirm_delete = false
        }

        // 纯本地翻转（可单测）：pinned 落库由 TogglePinActive 编排。
        .TogglePin(idx) -> {
            if idx < .notes.len() {
                // 先读进局部量再取反：a2r 对「取反 + 下标字段读」的 RHS 会发射出
                // 残缺表达式（Rust 轨编译失败）。
                var cur bool = .notes[idx].pinned
                .notes[idx].pinned = !cur
            }
        }

        // 置顶落库：dirty 先 flush；冲突时不动作、不清草稿。
        .TogglePinActive -> {
            if .notes.len() > 0 {
                if .dirty {
                    if .draft_request_id == "" {
                        .draft_request_id = next_request_id("ui-edit")
                    }
                    if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                        .dirty = false
                        .conflict = false
                        .draft_request_id = ""
                    } else {
                        .conflict = true
                    }
                }
                if .conflict == false {
                    toggle_pin(.notes[.active_id].id)
                    if .search == "" {
                        .notes = list_notes()
                    } else {
                        .notes = search_notes(.search)
                    }
                    .LoadDraft()
                    .ApplyFilter()
                }
            }
        }

        // 搜索：冲突时草稿入恢复槽后照常导航（SD-10）。
        .SetSearch(q) -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                } else {
                    .conflict = true
                    .StashDraft()
                    .dirty = false
                }
            }
            .search = q
            if .search == "" {
                .notes = list_notes()
            } else {
                .notes = search_notes(.search)
            }
            .active_id = 0
            .LoadDraft()
            .ApplyFilter()
        }

        // 筛选切换：flush 成功后**刷新 notes**（防旧正文冒充已保存——F-R4-04 P2）。
        .SelectFolder(f) -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    .notes = list_notes()
                } else {
                    .conflict = true
                    .StashDraft()
                    .dirty = false
                }
            }
            .active_folder = f
            .active_tag = ""
            .ApplyFilter()
            .SelectFirstVisible()
        }

        .SelectTag(t) -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    .notes = list_notes()
                } else {
                    .conflict = true
                    .StashDraft()
                    .dirty = false
                }
            }
            .active_tag = t
            .active_folder = "all"
            .ApplyFilter()
            .SelectFirstVisible()
        }

        .ClearTag -> {
            if .dirty {
                if .draft_request_id == "" {
                    .draft_request_id = next_request_id("ui-edit")
                }
                if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                    .dirty = false
                    .conflict = false
                    .draft_request_id = ""
                    .notes = list_notes()
                } else {
                    .conflict = true
                    .StashDraft()
                    .dirty = false
                }
            }
            .active_tag = ""
            .ApplyFilter()
            .SelectFirstVisible()
        }

        // 标签动作基于服务器当前版本执行；dirty 先 flush，失败时动作继续但
        // **绝不清草稿**（LoadDraft 由 dirty 守卫挡住）——F-R4-04 主诉。
        .TagAdded(t) -> {
            if .notes.len() > 0 {
                if .dirty {
                    if .draft_request_id == "" {
                        .draft_request_id = next_request_id("ui-edit")
                    }
                    if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                        .dirty = false
                        .conflict = false
                        .draft_request_id = ""
                    } else {
                        .conflict = true
                    }
                }
                var tl []str = []
                var exists bool = false
                for tg in .notes[.active_id].tags {
                    if tg == t {
                        exists = true
                    }
                    tl.push(tg)
                }
                if exists == false {
                    tl.push(t)
                }
                update_tags(.notes[.active_id].id, tl)
                var dup bool = false
                for e in .all_tags {
                    if e == t {
                        dup = true
                    }
                }
                if dup == false {
                    .all_tags.push(t)
                }
                if .search == "" {
                    .notes = list_notes()
                } else {
                    .notes = search_notes(.search)
                }
                .LoadDraft()
                .ApplyFilter()
            }
        }

        .TagRemoved(t) -> {
            if .notes.len() > 0 {
                if .dirty {
                    if .draft_request_id == "" {
                        .draft_request_id = next_request_id("ui-edit")
                    }
                    if update_note(.draft_id, .draft_revision, .draft_title, .draft_body, .draft_request_id) {
                        .dirty = false
                        .conflict = false
                        .draft_request_id = ""
                    } else {
                        .conflict = true
                    }
                }
                var tl []str = []
                for tg in .notes[.active_id].tags {
                    if tg != t {
                        tl.push(tg)
                    }
                }
                update_tags(.notes[.active_id].id, tl)
                if .search == "" {
                    .notes = list_notes()
                } else {
                    .notes = search_notes(.search)
                }
                .LoadDraft()
                .ApplyFilter()
            }
        }

        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }

        // 显式模式（外观面板 Dark/Light 两键）——走 ToggleDarkMode 保持
        // applyAccent 重放（T12-DARK 契约）。
        .SetMode(m) -> {
            if m == "dark" {
                if .dark_mode == false {
                    .ToggleDarkMode()
                }
            } else {
                if .dark_mode == true {
                    .ToggleDarkMode()
                }
            }
        }

        .SetAccent(name) -> {
            .accent_color = name
        }

        .ToggleSettings -> {
            .show_settings = !.show_settings
        }
    }
}
