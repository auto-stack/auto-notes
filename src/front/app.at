// app.at — 015-notes 应用骨架（PLAN-616 清爽化重做）。
//
// 布局：扁平双栏 + 顶栏，全部用发丝线（border-b / border-r）分隔，不再有
// 「悬浮卡片」外壳（PLAN-360 的卡片化视觉决策被本计划取代，主题色能力沿用）。
//
// 主题状态说明：主权在 store（applyAccent 的重放逻辑需要 store 持有
// dark_mode / accent_color），但 Vue 生成器把根元素的 `:class="{ dark: X }"`
// 绑到 **widget 本地** 的 dark_mode（vue.rs `dark_mode_on_widget` 分支），
// 所以 App 保留同名镜像，并在切换 handler 里与 store 同步。

use notes_store: NotesStore
use sidebar: NavTree
use editor: EditorPanel
// PLAN-056 T-02：官方主题包主题名导入（031 合同消费面——`dep themes` 声明
// 使包可解析，本 use 把包内 pub 主题收进收集链；无此行 themes 树不注册，
// design.theme/follow 宿主候选都会在 C-11 未注册拒绝）。
use themes.themes: Auto

// PLAN-607 style 配方：顶栏按钮两种形态。
// `w-auto` 必需：VM(iced) 端无显式宽度时按钮按 Fill 参与分配，会把顶栏撑开
// （SizeValue::Auto → IcedSize::Shrink，见 ui/style/iced_adapter.rs:1306）。
style icon_btn = "h-8 w-8 border-0 flex items-center justify-center rounded-md bg-transparent text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
style primary_btn = "h-9 w-auto border-0 flex items-center gap-1.5 px-3 rounded-md bg-primary text-primary-foreground text-sm font-medium shadow-sm hover:bg-primary/90 transition-colors"

// ── 快速卡片行视图（NOTES-002 T-02；view fn 调用点内联——同 NoteRow 律）。
// 附件行：URL 文本投影 + 图片块形真实预览（下载链接缺口 owner=工具链——
// link 仅 router `to:` 形）。
view fn CardAssetRow(a: Asset) {
    col {
        style: "items-stretch gap-1 w-full"
        row {
            style: "items-center gap-2 px-2 py-1 rounded-md bg-accent/30 w-auto"
            icon (name: "file", size: 12, style: "text-muted-foreground")
            text a.name { style: "text-xs text-foreground" }
            text a.download_url { style: "text-xs text-muted-foreground" }
        }
        if a.mime == "image/png" {
            image {
                src: a.raw_url
                alt: a.name
                fit: "contain"
                style: "w-full h-32 rounded-md border border-border object-contain"
            }
        }
        if a.mime == "image/jpeg" {
            image {
                src: a.raw_url
                alt: a.name
                fit: "contain"
                style: "w-full h-32 rounded-md border border-border object-contain"
            }
        }
        if a.mime == "image/gif" {
            image {
                src: a.raw_url
                alt: a.name
                fit: "contain"
                style: "w-full h-32 rounded-md border border-border object-contain"
            }
        }
        if a.mime == "image/webp" {
            image {
                src: a.raw_url
                alt: a.name
                fit: "contain"
                style: "w-full h-32 rounded-md border border-border object-contain"
            }
        }
    }
}

// 最近项行（k = 工作集下标，title 调用点传值——view fn 不反引 .store）。
view fn CardRecentRow(k: int, title: str) {
    button {
        onclick: .CardRecent(k)
        style: "h-7 w-auto border-0 flex items-center gap-1.5 px-2 rounded-md bg-transparent text-xs text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
        text title { style: "text-xs" }
    }
}

widget App {
    // NOTES-006 T-03：FeaturePack 可嵌入编辑组件（主应用第一消费者）——
    // 目录包形态（reader components 先例）：包内 widget 名并入组件注册表。
    use { package: official from "./components" }

    msg { Init, NewNote, ToggleDarkMode, SetMode(str), SetAccent(str), ToggleSettings,
          FpEditDraft(str), FpEditSubmit(str), FpEditRebase,
          FpCreateDraft(str), FpCreateSubmit(str), FpCreateRebase,
          FpOpenSource,
          CardOpened, CardClosed, CardAssetsReload, CardWidthToggled, CardSortToggled,
          CardRecent(int),
          WidgetOpened, WidgetClosed }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"
    }

    // PLAN-056 T-02：主题设计默认（独立默认腿）。theme="Auto" 经 pac
    // `dep themes`（vendor/themes 固定快照）注册的官方树解析；mode 由既有
    // dark_mode 状态驱动（默认 true = 暗色，与原 pac theme:"dark" 默认等价；
    // 宿主回写链 458 语义不变）。桌面内宿主策略完整快照（family+mode）按
    // 031 full-host 语义整体接管本默认（follow——pac theme 键保持缺省），
    // 独立/无宿主环境回落本默认；外观面板四色板（indigo/coral/ocean/sage）
    // 与顶栏 icon_btn/primary_btn 既有配方原样。
    design {
        theme: "Auto"
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        col {
            style: "w-full h-screen flex-col bg-background text-foreground overflow-hidden"

            // ── 顶栏 ─────────────────────────────────────────────────────
            row {
                style: "h-14 shrink-0 items-center justify-between gap-3 px-4 border-b border-border"
                row {
                    style: "w-auto items-center gap-2"
                    icon (name: "notebook", size: 18, style: "text-primary")
                    text "Notes" { style: "text-sm font-semibold tracking-tight" }
                }
                row {
                    style: "w-auto items-center gap-1"
                    button {
                        onclick: .ToggleDarkMode
                        style: icon_btn
                        if .store.dark_mode {
                            icon (name: "sun", size: 16)
                        } else {
                            icon (name: "moon", size: 16)
                        }
                    }
                    button {
                        onclick: .CardOpened
                        style: "h-8 w-auto border-0 flex items-center gap-1.5 px-2.5 rounded-md bg-transparent text-xs text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                        icon (name: "zap", size: 14)
                        text "Quick card" { style: "text-xs" }
                    }
                    button {
                        onclick: .WidgetOpened
                        style: "h-8 w-auto border-0 flex items-center gap-1.5 px-2.5 rounded-md bg-transparent text-xs text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                        icon (name: "widgets", size: 14)
                        text "Notes widget" { style: "text-xs" }
                    }
                    button {
                        onclick: .NewNote
                        style: primary_btn
                        icon (name: "plus", size: 15)
                        text "New note" { style: "text-sm font-medium" }
                    }
                }
            }

            // ── 主体：列表栏 + 编辑栏 ────────────────────────────────────
            row {
                style: "flex-1 min-h-0"
                NavTree(
                    on_toggle_dark_mode: .ToggleDarkMode,
                    on_set_mode: .SetMode,
                    on_set_accent: .SetAccent
                )
                col {
                    style: "flex-1 min-h-0"
                    if .store.notes.len() > 0 {
                        EditorPanel()
                    } else {
                        // 空态：一条笔记都没有（与「筛选无命中」区分开）
                        col {
                            style: "flex-1 items-center justify-center gap-3"
                            icon (name: "notebook", size: 40, style: "text-muted-foreground/40")
                            text "No notes yet" { style: "text-sm text-muted-foreground" }
                            button {
                                onclick: .NewNote
                                style: primary_btn
                                icon (name: "plus", size: 15)
                                text "Create your first note" { style: "text-sm font-medium" }
                            }
                        }
                    }
                }
            }

            // ── FeaturePack 编辑区（NOTES-006 T-03：主应用第一消费者）────
            // 双实例并存（AC-02）：edit 实例草稿与主编辑器同源（.draft_body，
            // 同一修订）；create 实例独立字段。冲突时宿主不写回 = 保输入；
            // 迟到回包/另一实例互不影响（每实例一对独立宿主字段）。
            col {
                style: "shrink-0 items-stretch gap-2 px-4 py-3 border-t border-border"
                row {
                    style: "items-center gap-3 w-auto"
                    text "FeaturePack" { style: "text-xs font-semibold text-muted-foreground" }
                    text .store.fp_edit_state { style: "text-xs text-muted-foreground" }
                    text .store.fp_create_state { style: "text-xs text-muted-foreground" }
                }
                row {
                    style: "items-stretch gap-3 w-auto"
                    if .store.draft_id != 0 {
                        FpNoteEditor (mode: "edit",
                                      note_label: .store.draft_title,
                                      draft_text: .store.draft_body,
                                      save_state: .store.fp_edit_state,
                                      conflict_revision: .store.fp_edit_conflict_rev,
                                      server_body: .store.fp_edit_server_body,
                                      on_draft_edit: .FpEditDraft,
                                      on_submit_text: .FpEditSubmit,
                                      on_rebase: .FpEditRebase) {}
                    }
                    FpNoteEditor (mode: "create",
                                  note_label: "",
                                  draft_text: .store.fp_create_text,
                                  save_state: .store.fp_create_state,
                                  conflict_revision: 0,
                                  server_body: "",
                                  on_draft_edit: .FpCreateDraft,
                                  on_submit_text: .FpCreateSubmit,
                                  on_rebase: .FpCreateRebase) {}
                }
                // ── 快速卡片（NOTES-002 T-02）：内联于 App（T-02 实测：组件
                // 目录单文件生成路径不传播 store deps——R002 store 未定义，
                // 最小复现 StoreTest 在案；缺口 owner=auto-ui-compiler）。
                // 同草稿/同七态透传：FpNoteEditor 直接绑 App.FpEdit*——卡片
                // 与管理页打开同一条 note_id/revision，打开期间并存（双 edit
                // 实例同源 prop）。关闭不清草稿（重开即恢复）。
                if .store.card_open {
                    col {
                        style: if .store.card_wide { "shrink-0 w-full max-w-2xl gap-2 px-3 py-3 rounded-lg border border-border bg-card shadow-sm items-stretch" } else { "shrink-0 w-full max-w-md gap-2 px-3 py-3 rounded-lg border border-border bg-card shadow-sm items-stretch" }

                        row {
                            style: "items-center gap-2 w-auto"
                            icon (name: "zap", size: 14, style: "text-primary")
                            text "Quick card" { style: "text-xs font-semibold text-primary" }
                            button {
                                onclick: .CardWidthToggled
                                style: "h-6 w-auto border-0 flex items-center gap-1 px-2 rounded-full bg-primary/10 text-xs text-primary font-medium hover:bg-primary/20 transition-colors"
                                if .store.card_wide {
                                    text "Narrow" { style: "text-xs" }
                                } else {
                                    text "Wide" { style: "text-xs" }
                                }
                            }
                            button {
                                onclick: .CardSortToggled
                                style: "h-6 w-auto border-0 flex items-center gap-1 px-2 rounded-full bg-primary/10 text-xs text-primary font-medium hover:bg-primary/20 transition-colors"
                                if .store.card_sort_title {
                                    text "Recent" { style: "text-xs" }
                                } else {
                                    text "Title" { style: "text-xs" }
                                }
                            }
                            button {
                                onclick: .CardAssetsReload
                                style: "h-6 w-auto border-0 flex items-center gap-1 px-2 rounded-full bg-transparent text-xs text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                                text "Refresh" { style: "text-xs" }
                            }
                            button {
                                onclick: .CardClosed
                                style: "h-6 w-6 border-0 flex items-center justify-center rounded-full bg-transparent text-xs text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                                text "×" { style: "text-xs" }
                            }
                        }

                        FpNoteEditor (mode: "edit", note_label: .store.draft_title,
                                      draft_text: .store.draft_body,
                                      save_state: .store.fp_edit_state,
                                      conflict_revision: .store.fp_edit_conflict_rev,
                                      server_body: .store.fp_edit_server_body,
                                      on_draft_edit: .FpEditDraft,
                                      on_submit_text: .FpEditSubmit,
                                      on_rebase: .FpEditRebase) {}

                        col {
                            style: "items-stretch gap-1"
                            row {
                                style: "items-center gap-1 w-auto"
                                icon (name: "paperclip", size: 12, style: "text-muted-foreground")
                                text "Attachments" { style: "text-xs text-muted-foreground" }
                            }
                            if .store.card_assets.len() == 0 {
                                text "No attachments" { style: "text-xs text-muted-foreground/70" }
                            }
                            for a in .store.card_assets {
                                CardAssetRow(a: a)
                            }
                        }

                        col {
                            style: "items-stretch gap-1"
                            row {
                                style: "items-center gap-1 w-auto"
                                icon (name: "clock", size: 12, style: "text-muted-foreground")
                                text "Recent" { style: "text-xs text-muted-foreground" }
                            }
                            if .store.card_recent.len() == 0 {
                                text "No recent notes" { style: "text-xs text-muted-foreground/70" }
                            }
                            for k in .store.card_recent {
                                CardRecentRow(k: k, title: .store.notes[k].title)
                            }
                        }
                    }
                }
                // ── 小组件（NOTES-003 T-01）：props 驱动组件（notes_widget.at）
                // 零 store 引用；宿主传同一 draft props（与主编辑器/快速卡片
                // 三处同源——同 note_id/revision）。关闭不清草稿（重开即恢复）。
                if .store.widget_open {
                    NotesWidget (note_label: .store.draft_title,
                                 draft_text: .store.draft_body,
                                 save_state: .store.fp_edit_state,
                                 conflict_revision: .store.fp_edit_conflict_rev,
                                 server_body: .store.fp_edit_server_body,
                                 assets: .store.card_assets,
                                 on_draft_edit: .FpEditDraft,
                                 on_submit_text: .FpEditSubmit,
                                 on_rebase: .FpEditRebase,
                                 on_close: .WidgetClosed) {}
                }
                // ── 来源卡（NOTES-006 r2 来源回访面；T-06 统一出口）────────
                // 配置与默认值：来源回访仅在 source_status=ok 时可用（冻结
                // 校验过的来源）；incomplete 显示「来源不完整」且回访入口
                // 不可用（明确不可回访状态）；none 不渲染。配置不提升服务
                // 权限——只投影本地已读数据。
                if .store.fp_src_status == "ok" {
                    col {
                        style: "items-start gap-1 px-3 py-2 rounded-md bg-muted w-auto"
                        row {
                            style: "items-center gap-2 w-auto"
                            icon (name: "book-open", size: 13, style: "text-muted-foreground")
                            text .store.fp_src_title { style: "text-xs font-medium text-foreground" }
                            text .store.fp_src_book { style: "text-xs text-muted-foreground" }
                        }
                        row {
                            style: "items-center gap-2 w-auto"
                            text .store.fp_src_quote { style: "text-xs text-muted-foreground" }
                            button {
                                onclick: .FpOpenSource
                                text "Open source" { style: "text-xs" }
                            }
                        }
                    }
                } else {
                    if .store.fp_src_status == "incomplete" {
                        row {
                            style: "items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 w-auto"
                            icon (name: "alert-triangle", size: 13, style: "text-amber-600")
                            text "Source incomplete (legacy) - revisit unavailable" { style: "text-xs text-amber-700" }
                        }
                    }
                }
                if .store.fp_open_active {
                    // OpenSource 消费投影（主应用 v0 = 来源详情卡；Reader 消费
                    // 同一出口做 locator 重验定位）。
                    col {
                        style: "items-start gap-1 px-3 py-2 rounded-md border border-border w-auto"
                        row {
                            style: "items-center gap-2 w-auto"
                            text "Source" { style: "text-xs font-semibold text-primary" }
                            text .store.fp_open_note { style: "text-xs text-muted-foreground" }
                        }
                        text .store.fp_src_author { style: "text-xs text-muted-foreground" }
                        text .store.fp_src_locator { style: "text-xs text-muted-foreground" }
                    }
                }
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .NewNote -> { store.NewNote() }
        // 双向同步：store 是主题主权（负责 applyAccent），本地镜像驱动根元素 dark class。
        .ToggleDarkMode -> {
            store.ToggleDarkMode()
            .dark_mode = .store.dark_mode
        }
        .SetMode(m) -> {
            store.SetMode(m)
            .dark_mode = .store.dark_mode
        }
        .SetAccent(name) -> {
            store.SetAccent(name)
            .accent_color = .store.accent_color
        }
        .ToggleSettings -> { store.ToggleSettings() }
        // ── FeaturePack 编辑组件宿主回调（NOTES-006 T-03） ──────────────
        .FpEditDraft(v) -> { store.FpEditDraft(v) }
        .FpEditSubmit(text) -> { store.FpEditSubmit(text) }
        .FpEditRebase -> { store.FpEditRebase() }
        .FpCreateDraft(v) -> { store.FpCreateDraft(v) }
        .FpCreateSubmit(text) -> { store.FpCreateSubmit(text) }
        .FpCreateRebase -> { store.FpCreateRebase() }
        .FpOpenSource -> { store.FpOpenSource() }
        // ── 快速卡片（NOTES-002 T-02） ──────────────────────────────────
        .CardOpened -> { store.CardOpened() }
        .CardClosed -> { store.CardClosed() }
        .CardAssetsReload -> { store.CardAssetsReload() }
        .CardWidthToggled -> { store.CardWidthToggled() }
        .CardSortToggled -> { store.CardSortToggled() }
        .CardRecent(k) -> { store.SelectNote(k) }
        // ── 小组件（NOTES-003 T-01） ────────────────────────────────────
        .WidgetOpened -> { store.WidgetOpened() }
        .WidgetClosed -> { store.WidgetClosed() }
    }
}
