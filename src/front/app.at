// app.at — 015-notes 应用骨架（PLAN-616 清爽化重做）。
//
// 布局：扁平双栏 + 顶栏，全部用发丝线（border-b / border-r）分隔，不再有
// 「悬浮卡片」外壳（PLAN-360 的卡片化视觉决策被本计划取代，主题色能力沿用）。
//
// 主题状态说明：主权在 store（applyAccent 的重放逻辑需要 store 持有
// dark_mode / accent_color），但 Vue 生成器把根元素的 `:class="{ dark: X }"`
// 绑到 **widget 本地** 的 dark_mode（vue.rs `dark_mode_on_widget` 分支），
// 所以 App 保留同名镜像，并在切换 handler 里与 store 同步。

use notes_store: NotesStore
use sidebar: NavTree
use editor: EditorPanel
// PLAN-056 T-02：官方主题包主题名导入（031 合同消费面——`dep themes` 声明
// 使包可解析，本 use 把包内 pub 主题收进收集链；无此行 themes 树不注册，
// design.theme/follow 宿主候选都会在 C-11 未注册拒绝）。
use themes.themes: Auto

// PLAN-607 style 配方：顶栏按钮两种形态。
// `w-auto` 必需：VM(iced) 端无显式宽度时按钮按 Fill 参与分配，会把顶栏撑开
// （SizeValue::Auto → IcedSize::Shrink，见 ui/style/iced_adapter.rs:1306）。
style icon_btn = "h-8 w-8 border-0 flex items-center justify-center rounded-md bg-transparent text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
style primary_btn = "h-9 w-auto border-0 flex items-center gap-1.5 px-3 rounded-md bg-primary text-primary-foreground text-sm font-medium shadow-sm hover:bg-primary/90 transition-colors"

widget App {
    msg { Init, NewNote, ToggleDarkMode, SetMode(str), SetAccent(str), ToggleSettings }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"
    }

    // PLAN-056 T-02：主题设计默认（独立默认腿）。theme="Auto" 经 pac
    // `dep themes`（vendor/themes 固定快照）注册的官方树解析；mode 由既有
    // dark_mode 状态驱动（默认 true = 暗色，与原 pac theme:"dark" 默认等价；
    // 宿主回写链 458 语义不变）。桌面内宿主策略完整快照（family+mode）按
    // 031 full-host 语义整体接管本默认（follow——pac theme 键保持缺省），
    // 独立/无宿主环境回落本默认；外观面板四色板（indigo/coral/ocean/sage）
    // 与顶栏 icon_btn/primary_btn 既有配方原样。
    design {
        theme: "Auto"
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        col {
            style: "w-full h-screen flex-col bg-background text-foreground overflow-hidden"

            // ── 顶栏 ─────────────────────────────────────────────────────
            row {
                style: "h-14 shrink-0 items-center justify-between gap-3 px-4 border-b border-border"
                row {
                    style: "w-auto items-center gap-2"
                    icon (name: "notebook", size: 18, style: "text-primary")
                    text "Notes" { style: "text-sm font-semibold tracking-tight" }
                }
                row {
                    style: "w-auto items-center gap-1"
                    button {
                        onclick: .ToggleDarkMode
                        style: icon_btn
                        if .store.dark_mode {
                            icon (name: "sun", size: 16)
                        } else {
                            icon (name: "moon", size: 16)
                        }
                    }
                    button {
                        onclick: .NewNote
                        style: primary_btn
                        icon (name: "plus", size: 15)
                        text "New note" { style: "text-sm font-medium" }
                    }
                }
            }

            // ── 主体：列表栏 + 编辑栏 ────────────────────────────────────
            row {
                style: "flex-1 min-h-0"
                NavTree(
                    on_toggle_dark_mode: .ToggleDarkMode,
                    on_set_mode: .SetMode,
                    on_set_accent: .SetAccent
                )
                col {
                    style: "flex-1 min-h-0"
                    if .store.notes.len() > 0 {
                        EditorPanel()
                    } else {
                        // 空态：一条笔记都没有（与「筛选无命中」区分开）
                        col {
                            style: "flex-1 items-center justify-center gap-3"
                            icon (name: "notebook", size: 40, style: "text-muted-foreground/40")
                            text "No notes yet" { style: "text-sm text-muted-foreground" }
                            button {
                                onclick: .NewNote
                                style: primary_btn
                                icon (name: "plus", size: 15)
                                text "Create your first note" { style: "text-sm font-medium" }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .NewNote -> { store.NewNote() }
        // 双向同步：store 是主题主权（负责 applyAccent），本地镜像驱动根元素 dark class。
        .ToggleDarkMode -> {
            store.ToggleDarkMode()
            .dark_mode = .store.dark_mode
        }
        .SetMode(m) -> {
            store.SetMode(m)
            .dark_mode = .store.dark_mode
        }
        .SetAccent(name) -> {
            store.SetAccent(name)
            .accent_color = .store.accent_color
        }
        .ToggleSettings -> { store.ToggleSettings() }
    }
}
